      "answer": "3",
      "answerIndex": 3,
      "given": {
        "divisor": 6,
        "quotient": 3
      },
      "solutionReasoning": {
        "steps": [
          "18 ÷ 6 asks: what times 6 makes 18?",
          "6 × 3 = 18, so 18 ÷ 6 = 3."
        ],
        "answer": "3"
      },
      "referenceExample": {
        "prompt": "Find 35 ÷ 5 by thinking: 5 × ? = 35.",
        "steps": [
          "5 × 7 = 35.",
          "So 35 ÷ 5 = 7."
        ],
        "answer": "7"
