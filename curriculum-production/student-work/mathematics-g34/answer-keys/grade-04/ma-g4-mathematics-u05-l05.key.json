      },
      "solutionReasoning": {
        "steps": [
          "6 × 83 = 498.",
          "499 − 498 = 1, and 1 is less than 6.",
          "So 499 ÷ 6 = 83 remainder 1."
        ],
        "answer": "83 r1"
      },
      "referenceExample": {
        "prompt": "Find 53 ÷ 6.",
        "steps": [
          "6 × 8 = 48.",
          "53 − 48 = 5, and 5 is less than 6.",
          "53 ÷ 6 = 8 remainder 5."
        ],
        "answer": "8 r5"
      },
      "verification": {
