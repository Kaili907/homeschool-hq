          "kind": "worked-example",
          "itemType": "subtract-within-1000",
          "standard": "3.NBT.2",
          "difficulty": 1,
          "prompt": "A farm had 512 apples. 168 apples were sold. How many apples are left?",
          "workedSolution": {
            "steps": [
              "512 − 168.",
              "Regroup a ten to subtract the ones: 12 − 8 = 4.",
              "Regroup a hundred to subtract the tens: 10 − 6 = 4.",
              "Subtract hundreds: 4 − 1 = 3.",
              "Difference: 344."
            ],
            "answer": "344"
          }
        },
        {
          "ref": "ma-g3-mathematics-u01-l17#ex-02",
          "kind": "worked-example",
          "itemType": "round-to-nearest-ten-or-hundred",
          "standard": "3.NBT.1",
          "difficulty": 2,
          "prompt": "Round 647 to the nearest 100.",
          "workedSolution": {
            "steps": [
              "The nearest multiples of 100 are 600 and 700.",
              "647 is 47 away from 600 and 53 away from 700.",
              "600 is nearer, so 647 rounds to 600."
            ],
            "answer": "600"
          }
        }
      ]
    },
