          "standard": "3.OA.2",
          "difficulty": 1,
          "prompt": "18 marbles are shared equally among 3 bags. How many marbles in each bag?",
          "workedSolution": {
            "steps": [
              "18 ÷ 3 asks how many are in each of 3 equal groups.",
              "3 × 6 = 18, so 18 ÷ 3 = 6."
            ],
            "answer": "6"
          }
        }
      ]
