          "standard": "3.G.2",
          "difficulty": 1,
          "prompt": "A rectangle is partitioned into 4 parts of equal area. What fraction does one part represent?",
          "workedSolution": {
            "steps": [
              "4 equal parts make up the whole.",
              "One part is 1/4."
            ],
            "answer": "1/4"
          }
        },
        {
          "ref": "ma-g3-mathematics-u05-l02#ex-02",
          "kind": "worked-example",
          "itemType": "identify-unit-fraction",
          "standard": "3.NF.1",
          "difficulty": 2,
          "prompt": "A shape is divided into 6 equal parts. 5 are shaded. What fraction is shaded?",
          "workedSolution": {
            "steps": [
              "6 equal parts is the denominator.",
              "5 shaded parts is the numerator.",
              "The fraction is 5/6."
            ],
            "answer": "5/6"
          }
        }
      ]
