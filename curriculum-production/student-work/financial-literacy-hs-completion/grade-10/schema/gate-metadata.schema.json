{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-metadata.schema.json",
  "title": "Production Gate H3 responseScoring projection for one lane",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "lane", "grade", "units", "subjectFamily", "structuredDiscipline",
    "sourceCorpusVersion", "gateContract", "modeMapping", "counts", "lessons"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "lane": { "type": "string" },
    "grade": { "const": 10 },
    "units": { "type": "array", "items": { "type": "integer" } },
    "subjectFamily": { "const": "MATH_STRUCTURED_FINLIT" },
    "structuredDiscipline": { "const": "FINANCIAL_LITERACY" },
    "sourceCorpusVersion": { "type": "string" },
    "gateContract": { "type": "string" },
    "modeMapping": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lessons", "byLaneKind", "byResponseMode", "fixedItems", "openItems"],
      "properties": {
        "lessons": { "type": "integer" },
        "byLaneKind": { "type": "object" },
        "byResponseMode": { "type": "object" },
        "fixedItems": { "type": "integer" },
        "openItems": { "type": "integer" }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packageId", "lessonId", "unit", "day", "subjectFamily", "structuredDiscipline",
          "laneScoringKind", "responseScoring", "fixedItemCount", "openItemCount", "oracleVerifiedFixedAnswers"
        ],
        "properties": {
          "packageId": { "type": "string" },
          "lessonId": { "type": "string" },
          "unit": { "type": "integer" },
          "day": { "type": "integer" },
          "subjectFamily": { "const": "MATH_STRUCTURED_FINLIT" },
          "structuredDiscipline": { "const": "FINANCIAL_LITERACY" },
          "laneScoringKind": { "enum": ["ANSWER_KEY", "RUBRIC", "HYBRID"] },
          "responseScoring": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "items"],
            "properties": {
              "mode": { "enum": ["FIXED_OR_COMPUTATIONAL", "JUDGMENT_APPLICATION", "MIXED"] },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ref", "responseMode", "promptText"],
                  "properties": {
                    "ref": { "type": "string" },
                    "responseMode": { "enum": ["FIXED", "OPEN"] },
                    "promptText": { "type": "string" }
                  }
                }
              }
            }
          },
          "fixedItemCount": { "type": "integer" },
          "openItemCount": { "type": "integer" },
          "oracleVerifiedFixedAnswers": { "type": "integer" }
        }
      }
    }
  }
}
