{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manuel-academy/technology-arts-lessons/lesson-task-package",
  "title": "Lesson task package",
  "description": "One student-ready task for ONE authored lesson. The work shape comes from the lesson's phase; the content comes from its focus, objectives, and success criteria.",
  "type": "object",
  "required": [
    "schema_version",
    "lesson_id",
    "unit_id",
    "source_course_id",
    "subject",
    "band",
    "grade",
    "grade_dir",
    "unit_number",
    "unit_title",
    "day_in_unit",
    "lesson_title",
    "phase",
    "work_mode",
    "focus",
    "task_type",
    "task_label",
    "scoring_stance",
    "estimated_minutes",
    "standards",
    "learning_objectives",
    "lesson_success_criteria",
    "task_brief",
    "primary_task",
    "requirements",
    "deliverable",
    "presentation_and_privacy",
    "copyright_and_authorship",
    "accessibility_options",
    "remediation",
    "extension",
    "unit_context",
    "task_accessibility_provisions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lesson_id": {
      "type": "string",
      "minLength": 1
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "source_course_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "enum": [
        "technology",
        "arts-music"
      ]
    },
    "band": {
      "enum": [
        "g3-4",
        "canonical-5-7-8",
        "hs-9-12"
      ]
    },
    "grade": {
      "enum": [
        3,
        4,
        5,
        7,
        8,
        9,
        10,
        11,
        12
      ]
    },
    "grade_dir": {
      "type": "string",
      "pattern": "^grade-\\d{2}$"
    },
    "unit_number": {
      "type": "integer",
      "minimum": 1
    },
    "unit_title": {
      "type": "string",
      "minLength": 1
    },
    "day_in_unit": {
      "type": "integer",
      "minimum": 1
    },
    "course_day": {
      "type": "integer",
      "minimum": 1
    },
    "lesson_title": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "work_mode": {
      "description": "Archetype selected by the lesson phase \u2014 the reason this task is not the unit task repeated.",
      "enum": [
        "PROBE",
        "MODEL",
        "MODEL_A",
        "MODEL_B",
        "GUIDED",
        "GUIDED_A",
        "GUIDED_B",
        "APPLY",
        "BUILD",
        "INVESTIGATE",
        "RETEACH",
        "INCREMENT",
        "DEMONSTRATE",
        "SYNTHESIZE",
        "ASSESS",
        "CORRECT"
      ]
    },
    "focus": {
      "type": "string",
      "minLength": 1,
      "description": "The authored lesson focus, verbatim."
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "task_label": {
      "type": "string",
      "minLength": 1
    },
    "scoring_stance": {
      "enum": [
        "FORMATIVE_NO_PENALTY",
        "PROGRESS_EVIDENCE",
        "SUMMATIVE"
      ]
    },
    "estimated_minutes": {
      "type": "string"
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "essential_question": {
      "type": "string"
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "lesson_success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_brief": {
      "type": "string",
      "minLength": 120
    },
    "primary_task": {
      "type": "string",
      "minLength": 200
    },
    "requirements": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "deliverable": {
      "type": "string",
      "minLength": 40
    },
    "guided_scaffold_note": {
      "type": "string"
    },
    "test_or_check_criteria": {
      "description": "Technology only: the explicit pass/fail checks the work is verified against.",
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "critique_criteria": {
      "description": "Arts/music only: the criteria the created or analysed work is critiqued against.",
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "presentation_and_privacy": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "sandbox_and_credentials_note"
          ],
          "properties": {
            "sandbox_and_credentials_note": {
              "type": "string",
              "minLength": 100
            }
          },
          "additionalProperties": false
        },
        {
          "required": [
            "presentation_options",
            "text_or_no_audio_alternative"
          ],
          "properties": {
            "presentation_options": {
              "type": "string",
              "minLength": 100
            },
            "text_or_no_audio_alternative": {
              "type": "string",
              "minLength": 100
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "copyright_and_authorship": {
      "type": "string",
      "minLength": 100
    },
    "accessibility_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "safety_and_privacy_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "media": {
      "type": "object"
    },
    "remediation": {
      "type": "string",
      "minLength": 100
    },
    "extension": {
      "type": "string",
      "minLength": 60
    },
    "unit_context": {
      "type": "object",
      "required": [
        "performance_task",
        "topics"
      ],
      "properties": {
        "performance_task": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "essential_question": {
          "type": "string"
        },
        "assessment_id": {
          "type": "string"
        }
      }
    },
    "task_steps": {
      "description": "Elementary grades only: the task body chunked into one action per step.",
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "task_accessibility_provisions": {
      "description": "Access provisions derived from what THIS task concretely demands, added alongside the authored accessibility_options.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 40
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": {
            "const": "technology"
          }
        }
      },
      "then": {
        "required": [
          "test_or_check_criteria"
        ],
        "not": {
          "required": [
            "critique_criteria"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject": {
            "const": "arts-music"
          }
        }
      },
      "then": {
        "required": [
          "critique_criteria"
        ],
        "not": {
          "required": [
            "test_or_check_criteria"
          ]
        }
      }
    }
  ]
}
