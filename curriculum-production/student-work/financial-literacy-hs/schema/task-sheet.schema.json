{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuel-academy.local/schema/finlit-hs-task-sheet.schema.json",
  "title": "High School Financial Literacy student-work task sheet (student projection)",
  "description": "Learner-facing material for one lesson, grades 9-12. Carries no answer, no rubric descriptor, and no look-for: those live in the sibling scoring record named by scoringRef. A learner reading this file alone cannot see how the work is graded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "packageId", "lessonRef", "subjectFamily", "standardsRefs", "focus",
    "objective", "scenario", "isFictionalSimulation", "completionAuthority", "realWorldAction",
    "signOff", "safetyNotes", "simulationAlternative", "materials", "tasks", "remediation",
    "extension", "scoringRef", "financialSafety", "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packageId": { "type": "string", "pattern": "^swk-flhs-g(9|10|11|12)-u\\d{2}-l\\d{2}$" },
    "lessonRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lessonId", "courseId", "grade", "subject", "unitNumber", "unitTitle", "dayInUnit", "phase", "title"],
      "properties": {
        "lessonId": { "type": "string", "pattern": "^ma-g(9|10|11|12)-financial-literacy-" },
        "courseId": { "type": "string" },
        "grade": { "type": "integer", "enum": [9, 10, 11, 12] },
        "subject": { "const": "financial-literacy" },
        "unitNumber": { "type": "integer", "minimum": 1, "maximum": 7 },
        "unitTitle": { "type": "string" },
        "dayInUnit": { "type": "integer", "minimum": 1 },
        "phase": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "subjectFamily": { "const": "MATH_STRUCTURED_FINLIT" },
    "standardsRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "focus": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "isFictionalSimulation": {
      "const": true,
      "description": "True without exception in this lane: no real money, account, institution, or transaction is ever involved."
    },
    "completionAuthority": { "const": "learner" },
    "realWorldAction": { "const": false },
    "signOff": { "type": "null" },
    "safetyNotes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "simulationAlternative": {
      "type": "null",
      "description": "Always null here: realWorldAction is false throughout, so no lesson needs an alternative route."
    },
    "materials": { "type": "array", "items": { "type": "string" } },
    "tasks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "kind", "directions", "prompts"],
        "properties": {
          "taskId": { "type": "string" },
          "kind": { "enum": ["warm-up", "guided", "independent", "performance-task", "reflection"] },
          "directions": { "type": "string", "minLength": 1 },
          "prompts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "promptType", "text"],
              "properties": {
                "ref": { "type": "string" },
                "promptType": { "enum": ["fixed-numeric", "fixed-choice", "short-response", "extended-response"] },
                "text": { "type": "string", "minLength": 20 },
                "choices": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
                "unit": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "remediation": { "type": "string", "minLength": 80 },
    "extension": { "type": "string", "minLength": 60 },
    "scoringRef": { "type": "string", "pattern": "^scoring/grade-\\d{2}/" },
    "financialSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["neverRequestsRealCredentials", "noIndividualizedAdvice"],
      "properties": {
        "neverRequestsRealCredentials": { "const": true },
        "noIndividualizedAdvice": { "const": true }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCorpusVersion", "sourceLessonId", "sourceStage", "authoredBy"],
      "properties": {
        "sourceCorpusVersion": {
          "type": "string",
          "description": "Branch and pinned SHA of the source corpus. Not a release version: grades 9-12 are not in any release."
        },
        "sourceLessonId": { "type": "string" },
        "sourceStage": { "const": "authoring" },
        "authoredBy": { "const": "manual" }
      }
    }
  }
}
