{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuel-academy.local/schema/finlit-hs-scoring-record.schema.json",
  "title": "High School Financial Literacy scoring record (adult-only projection)",
  "description": "Scoring authority for one lesson's task sheet, never shipped to a learner-facing renderer. Fixed answers here were recomputed from the item's own stated parameters, not transcribed; judgment items carry no exact key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "lessonId", "scoringAuthority", "completionAuthority", "nonDiagnosticGuard", "oracle"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packageId": { "type": "string", "pattern": "^swk-flhs-" },
    "lessonId": { "type": "string" },
    "scoringAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["ANSWER_KEY", "RUBRIC", "HYBRID"],
          "description": "HYBRID where a lesson mixes fixed items with judgment items, which is the normal case in this lane."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "answer", "verification"],
            "properties": {
              "ref": { "type": "string" },
              "answer": { "type": "string", "minLength": 1 },
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "required": ["method", "reasoning"],
                "properties": {
                  "method": { "enum": ["recomputed", "derived-from-comparison", "asserted-fixed-value"] },
                  "reasoning": {
                    "type": "string",
                    "minLength": 30,
                    "description": "Why this computation is the right one for the scenario. This is the part recomputation cannot supply; it is what a reviewer checks against the prose."
                  }
                }
              }
            }
          }
        },
        "workedSolution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "expression", "substituted", "result", "why"],
            "properties": {
              "ref": { "type": "string" },
              "expression": { "type": "string" },
              "substituted": { "type": "string" },
              "result": { "type": "string" },
              "why": { "type": "string", "minLength": 30 }
            }
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "levels"],
            "properties": {
              "dimension": { "type": "string" },
              "levels": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "descriptor"],
                  "properties": {
                    "label": { "enum": ["Not yet", "Approaching", "Meets", "Exceeds"] },
                    "descriptor": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "judgment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "prompt", "scoredBy", "exactKey", "acceptableAnswerCriteria", "evidenceRequirements", "lookFors", "dimensions"],
            "properties": {
              "ref": { "type": "string" },
              "prompt": { "type": "string" },
              "scoredBy": { "const": "rubric" },
              "exactKey": {
                "type": "null",
                "description": "Always null. A judgment item scored against an invented exact answer is the failure this field exists to make impossible."
              },
              "acceptableAnswerCriteria": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 40 } },
              "evidenceRequirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 25 } },
              "lookFors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "commonMisconception": { "type": "string" },
              "dimensions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "completionAuthority": { "const": "learner" },
    "nonDiagnosticGuard": { "const": "Do not infer effort, motivation, diagnosis, or character from an error." },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "arithmetic", "failsClosed", "recomputedNumericAnswers", "comparisonDerivedChoices", "assertedChoices", "limits"],
      "properties": {
        "method": { "type": "string" },
        "arithmetic": { "type": "string" },
        "failsClosed": { "const": true },
        "recomputedNumericAnswers": { "type": "integer", "minimum": 0 },
        "comparisonDerivedChoices": { "type": "integer", "minimum": 0 },
        "assertedChoices": { "type": "integer", "minimum": 0 },
        "limits": {
          "type": "string",
          "description": "Stated in every record rather than left implicit: recomputation shows the key follows from the stated figures, not that the model is right."
        }
      }
    }
  }
}
