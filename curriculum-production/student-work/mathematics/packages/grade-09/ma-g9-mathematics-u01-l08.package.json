          "standard": "N-Q.2",
          "difficulty": 2,
          "prompt": "What unit should describe how quickly a tank fills?",
          "workedSolution": {
            "steps": [
              "The model relates volume to time.",
              "The derived unit is volume divided by time."
            ],
            "answer": "litres per minute"
          }
        }
