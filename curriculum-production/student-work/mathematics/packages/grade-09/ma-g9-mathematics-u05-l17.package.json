          "standard": "A-SSE.3",
          "difficulty": 1,
          "prompt": "Write x² − 6x + 11 in vertex form.",
          "workedSolution": {
            "steps": [
              "Half of −6 is −3; (−3)² = 9.",
              "x² − 6x + 9 + 2 = (x − 3)² + 2.",
              "Vertex (3, 2)."
            ],
            "answer": "(x − 3)² + 2; vertex (3, 2)"
          }
        },
