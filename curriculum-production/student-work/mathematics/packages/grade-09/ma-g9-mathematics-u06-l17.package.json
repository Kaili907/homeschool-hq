          "difficulty": 1,
          "prompt": "A costs $4, B costs $7, budget $50. Write the constraint.",
          "workedSolution": {
            "steps": [
              "Total spend is 4a + 7b.",
              "\"At most\" gives ≤.",
              "4a + 7b ≤ 50."
            ],
            "answer": "4a + 7b ≤ 50"
          }
        },
        {
          "ref": "ma-g9-mathematics-u06-l17#ex-02",
