          "kind": "worked-example",
          "itemType": "union-and-intersection-probability",
          "standard": "S-CP.1",
          "difficulty": 1,
          "prompt": "30 people; 18 do A, 14 do B, 7 do both. Find P(A or B).",
          "workedSolution": {
            "steps": [
              "18 + 14 − 7 = 25.",
              "25/30 = 5/6."
            ],
            "answer": "5/6"
          }
        },
        {
          "ref": "ma-g11-mathematics-u08-l08#ex-02",
          "kind": "worked-example",
          "itemType": "complement-and-at-least-one",
          "standard": "S-CP.3",
          "difficulty": 2,
          "prompt": "P(success) = 1/3 per trial, two trials. P(at least one)?",
          "workedSolution": {
            "steps": [
              "P(no success) = (2/3)² = 4/9.",
              "1 − 4/9 = 5/9."
            ],
            "answer": "5/9"
          }
        }
      ]
