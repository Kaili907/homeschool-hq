        {
          "ref": "ma-g11-mathematics-u07-l17#ex-02",
          "kind": "worked-example",
          "itemType": "find-inverse-function",
          "standard": "F-BF.4",
          "difficulty": 2,
          "prompt": "Find the inverse of f(x) = 3x + 6.",
          "workedSolution": {
            "steps": [
              "x = 3y + 6.",
              "3y = x − 6.",
              "y = (x − 6)/3."
            ],
            "answer": "f⁻¹(x) = (x − 6)/3"
          }
        }
      ]
