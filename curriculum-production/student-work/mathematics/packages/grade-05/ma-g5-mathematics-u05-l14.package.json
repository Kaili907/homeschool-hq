          "difficulty": 1,
          "prompt": "Compare 5/8 with the benchmark 1/2 using <, >, or =.",
          "workedSolution": {
            "steps": [
              "Rewrite 1/2 as eighths: 1/2 = 4/8.",
              "Five eighths is greater than four eighths.",
              "Therefore, 5/8 > 1/2."
            ],
            "answer": ">"
