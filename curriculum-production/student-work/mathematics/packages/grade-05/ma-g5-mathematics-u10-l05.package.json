          "itemType": "choose-operation",
          "standard": "5.OA.1",
          "difficulty": 2,
          "prompt": "6 packs hold 8 pencils each and 3 are loose. How many pencils?",
          "workedSolution": {
            "steps": [
              "Multiply: 6 × 8 = 48.",
              "Add 3 loose pencils: 51."
            ],
            "answer": "51"
          }
