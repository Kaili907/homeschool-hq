      "directions": "These two examples show the same idea in two different formats.",
      "items": [
        {
          "ref": "ma-g8-mathematics-u02-l08#ex-01",
          "kind": "worked-example",
          "itemType": "power-of-a-power",
          "standard": "8.EE.1",
          "difficulty": 1,
          "prompt": "Simplify (3^-2)^4.",
          "workedSolution": {
            "steps": [
              "When raising a power to a power, multiply the exponents.",
              "-2 × 4 = -8, so the result is 3^-8."
            ],
            "answer": "3^-8"
          }
        },
        {
          "ref": "ma-g8-mathematics-u02-l08#ex-02",
          "kind": "worked-example",
          "itemType": "evaluate-power-of-ten",
          "standard": "8.EE.1",
          "difficulty": 2,
          "prompt": "Evaluate 10^-3.",
          "workedSolution": {
            "steps": [
              "A negative exponent moves the 1 to the right of the decimal point.",
              "10^-3 = 1/1000 = 0.001."
            ],
            "answer": "0.001"
          }
        }
      ]
