          "standard": "8.EE.7",
          "difficulty": 1,
          "prompt": "A bike rental costs $5 plus $3 per hour. The total cost was $20. Which equation represents the number of hours, x?",
          "workedSolution": {
            "steps": [
              "The flat fee of 5 is added once.",
              "The hourly rate of 3 multiplies the hours, x."
            ],
            "answer": "3x + 5 = 20"
          }
        },
