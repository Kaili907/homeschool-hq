          "difficulty": 1,
          "prompt": "A student solves 3x + 4 = 19. They write 3x = 15, then say x = 15. Which statement best analyzes the error?",
          "workedSolution": {
            "steps": [
              "3x = 15 is correct so far.",
              "Dividing both sides by 3 gives x = 5, not 15."
            ],
            "answer": "The student forgot to divide both sides by 3; the correct solution is x = 5."
          }
        }
