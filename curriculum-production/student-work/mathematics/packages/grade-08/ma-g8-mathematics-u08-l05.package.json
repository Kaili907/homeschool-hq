          "standard": "8.G.6",
          "difficulty": 2,
          "prompt": "A student says 3² + 4² = 7². Is this correct?",
          "workedSolution": {
            "steps": [
              "Identify the legs and the hypotenuse, the side opposite the right angle.",
              "Use a² + b² = c² and take a square root only after finding c²."
            ],
            "answer": "No; 3² + 4² = 25, so c = 5."
          }
        }
