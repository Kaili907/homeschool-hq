          "standard": "8.G.8",
          "difficulty": 1,
          "prompt": "A 10-ft ladder reaches 8 ft up a wall. How far is its base from the wall?",
          "workedSolution": {
            "steps": [
              "Identify the legs and the hypotenuse, the side opposite the right angle.",
              "Use a² + b² = c² and take a square root only after finding c²."
            ],
            "answer": "6 ft"
          }
        },
        {
          "ref": "ma-g8-mathematics-u08-l05#ex-02",
          "kind": "worked-example",
