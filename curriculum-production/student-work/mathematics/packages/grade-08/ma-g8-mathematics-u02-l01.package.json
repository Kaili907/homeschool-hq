          "standard": "8.EE.1",
          "difficulty": 1,
          "prompt": "Evaluate 5^-2.",
          "workedSolution": {
            "steps": [
              "A negative exponent means reciprocal: 5^-2 = 1/5².",
              "5² = 25, so 5^-2 = 1/25."
            ],
            "answer": "1/25"
          }
        }
      ]
