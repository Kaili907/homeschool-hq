          "standard": "7.G.4",
          "difficulty": 1,
          "prompt": "A circle has a radius of 5 cm. What is its exact circumference?",
          "workedSolution": {
            "steps": [
              "The diameter is twice the radius: 2 × 5 = 10 cm.",
              "Circumference is π times the diameter: C = πd = 10π cm."
            ],
            "answer": "10π cm"
          }
        }
      ]
