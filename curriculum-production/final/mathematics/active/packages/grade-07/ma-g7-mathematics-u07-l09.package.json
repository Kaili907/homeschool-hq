          "standard": "7.G.5",
          "difficulty": 1,
          "prompt": "Two angles are supplementary. One measures 125°. What is the measure of the other angle?",
          "workedSolution": {
            "steps": [
              "Supplementary angles sum to 180°.",
              "Subtract the known angle: 180 − 125 = 55°."
            ],
            "answer": "55°"
          }
        }
