      "kind": "instructional-example",
      "title": "Instructional examples",
      "directions": "Compare these two examples. Find the step where they stop being the same.",
      "items": [
        {
          "ref": "ma-g7-mathematics-u07-l05#ex-01",
          "kind": "worked-example",
          "itemType": "area-of-composite-figure",
          "standard": "7.G.6",
          "difficulty": 1,
          "prompt": "A room shaped like an L is made from a 10-by-8 rectangle with a 3-by-2 rectangular corner cut out. What is the area of the room, in square units?",
          "workedSolution": {
            "steps": [
              "Find the area of the full rectangle: 10 × 8 = 80.",
              "Find the area of the removed corner: 3 × 2 = 6.",
              "Subtract the corner from the rectangle: 80 − 6 = 74 square units."
            ],
            "answer": "74"
          }
        },
        {
          "ref": "ma-g7-mathematics-u07-l05#ex-02",
          "kind": "worked-example",
          "itemType": "missing-dimension-from-area",
          "standard": "7.G.6",
          "difficulty": 2,
          "prompt": "A rectangle has an area of 51 square units and a width of 6 units. What is its exact length?",
          "workedSolution": {
            "steps": [
              "Length equals area divided by width: 51 ÷ 6.",
              "Write the exact quotient as a fraction: 51/6 = 17/2.",
              "Rewrite as a mixed number: 17/2 = 8 1/2."
            ],
            "answer": "8 1/2"
          }
        }
      ]
    },
