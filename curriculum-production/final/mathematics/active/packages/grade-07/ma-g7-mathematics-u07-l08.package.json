      "sectionId": "ex",
      "kind": "instructional-example",
      "title": "Instructional examples",
      "directions": "These two examples show the same idea in two different formats.",
      "items": [
        {
          "ref": "ma-g7-mathematics-u07-l08#ex-01",
          "kind": "worked-example",
          "itemType": "area-of-circle-from-radius-or-diameter",
          "standard": "7.G.4",
          "difficulty": 1,
          "prompt": "A circle has a radius of 6 ft. What is its exact area?",
          "workedSolution": {
            "steps": [
              "Area is π times the radius squared: A = πr².",
              "Square the radius: 6² = 36, so A = 36π ft²."
            ],
            "answer": "36π ft²"
          }
        },
        {
          "ref": "ma-g7-mathematics-u07-l08#ex-02",
          "kind": "worked-example",
          "itemType": "circumference-area-relationship",
          "standard": "7.G.4",
          "difficulty": 2,
          "prompt": "A circle has a circumference of 8π m. A circle’s radius equals its circumference divided by 2π. Use this relationship to find the circle’s exact area.",
          "workedSolution": {
            "steps": [
              "Divide the circumference coefficient by 2 to get the radius: 8 ÷ 2 = 4 m.",
              "Square the radius and multiply by π: A = π(4)² = 16π m²."
            ],
            "answer": "16π m²"
          }
        }
      ]
    },
