      "items": [
        {
          "ref": "ma-g7-mathematics-u07-l04#ex-01",
          "kind": "worked-example",
          "itemType": "angle-equation-multistep",
          "standard": "7.G.5",
          "difficulty": 1,
          "prompt": "Two angles are supplementary. Their measures are (4x + 6)° and (2x + 24)°. Find the value of x and the measure of each angle.",
          "workedSolution": {
            "steps": [
              "Supplementary angles sum to 180°: (4x + 6) + (2x + 24) = 180.",
              "Combine like terms: 6x + 30 = 180, so 6x = 150 and x = 25.",
              "Substitute back: 4(25) + 6 = 106°, and 180 − 106 = 74°."
            ],
            "answer": "x = 25, angles measure 106° and 74°"
          }
        }
      ]
    },
