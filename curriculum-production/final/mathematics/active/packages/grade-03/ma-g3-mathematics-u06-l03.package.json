      "directions": "Compare these two examples. Find the step where they stop being the same.",
      "items": [
        {
          "ref": "ma-g3-mathematics-u06-l03#ex-01",
          "kind": "worked-example",
          "itemType": "equivalent-fractions",
          "standard": "3.NF.3",
          "difficulty": 1,
          "prompt": "Which fraction is equivalent to 1/3?",
          "workedSolution": {
            "steps": [
              "Multiply numerator and denominator by 2.",
              "1 × 2 = 2, 3 × 2 = 6.",
              "1/3 = 2/6."
            ],
            "answer": "2/6"
          }
        },
        {
          "ref": "ma-g3-mathematics-u06-l03#ex-02",
          "kind": "worked-example",
          "itemType": "compare-fractions-same-whole",
          "standard": "3.NF.3",
          "difficulty": 2,
          "prompt": "Which fraction is greater: 3/8 or 5/8?",
          "workedSolution": {
            "steps": [
              "Same whole, same denominator.",
              "5 eighths is more than 3 eighths.",
              "5/8 is greater."
            ],
            "answer": "5/8"
          }
        }
      ]
