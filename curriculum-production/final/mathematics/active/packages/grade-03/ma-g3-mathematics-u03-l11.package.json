          "difficulty": 1,
          "prompt": "Find 6 × 40.",
          "workedSolution": {
            "steps": [
              "40 is 4 tens, so 6 × 40 = 6 × 4 × 10.",
              "6 × 4 = 24.",
              "24 × 10 = 240."
