          "prompt": "A movie starts at 2:15 p.m. and lasts 40 minutes. What time does it end?",
          "workedSolution": {
            "steps": [
              "Start at 2:15 p.m. and count forward 40 minutes.",
              "2:15 + 40 minutes = 2:55 p.m."
            ],
            "answer": "2:55 p.m."
