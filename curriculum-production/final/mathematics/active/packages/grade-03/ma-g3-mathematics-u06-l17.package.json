          "itemType": "compare-fractions-same-whole",
          "standard": "3.NF.3",
          "difficulty": 2,
          "prompt": "Which fraction is greater: 3/8 or 5/8?",
          "workedSolution": {
            "steps": [
              "Same whole, same denominator.",
              "5 eighths is more than 3 eighths.",
              "5/8 is greater."
            ],
            "answer": "5/8"
          }
        }
      ]
