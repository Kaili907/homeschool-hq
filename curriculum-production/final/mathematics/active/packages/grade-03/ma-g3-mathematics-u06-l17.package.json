          "difficulty": 1,
          "prompt": "Which fraction is equivalent to 1/3?",
          "workedSolution": {
            "steps": [
              "Multiply numerator and denominator by 2.",
              "1 × 2 = 2, 3 × 2 = 6.",
              "1/3 = 2/6."
            ],
            "answer": "2/6"
          }
        },
        {
          "ref": "ma-g3-mathematics-u06-l17#ex-02",
