          "standard": "3.NF.2",
          "difficulty": 1,
          "prompt": "A number line from 0 to 1 is divided into 4 equal lengths. What fraction names the point 1 length from 0?",
          "workedSolution": {
            "steps": [
              "Each length is 1/4.",
              "1 length from 0 is 1/4."
            ],
            "answer": "1/4"
          }
        },
        {
          "ref": "ma-g3-mathematics-u06-l02#ex-02",
          "kind": "worked-example",
          "itemType": "equivalent-fractions",
          "standard": "3.NF.3",
          "difficulty": 2,
          "prompt": "Which fraction is equivalent to 1/3?",
          "workedSolution": {
            "steps": [
              "Multiply numerator and denominator by 2.",
              "1 × 2 = 2, 3 × 2 = 6.",
              "1/3 = 2/6."
            ],
            "answer": "2/6"
          }
        }
      ]
