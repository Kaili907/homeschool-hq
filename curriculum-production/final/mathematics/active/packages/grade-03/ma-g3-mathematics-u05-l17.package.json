          "standard": "3.NF.1",
          "difficulty": 1,
          "prompt": "A shape is divided into 6 equal parts. 5 are shaded. What fraction is shaded?",
          "workedSolution": {
            "steps": [
              "6 equal parts is the denominator.",
              "5 shaded parts is the numerator.",
              "The fraction is 5/6."
            ],
            "answer": "5/6"
          }
        },
        {
          "ref": "ma-g3-mathematics-u05-l17#ex-02",
          "kind": "worked-example",
          "itemType": "fraction-on-number-line",
          "standard": "3.NF.2",
          "difficulty": 2,
          "prompt": "A number line from 0 to 1 is divided into 6 equal lengths. What fraction names the point 4 lengths from 0?",
          "workedSolution": {
            "steps": [
              "Each length is 1/6.",
              "4 lengths from 0 is 4/6."
            ],
            "answer": "4/6"
          }
        }
      ]
