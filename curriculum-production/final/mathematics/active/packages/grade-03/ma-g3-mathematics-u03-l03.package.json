          "difficulty": 1,
          "prompt": "Find 54 ÷ 9.",
          "workedSolution": {
            "steps": [
              "9 × 6 = 54.",
              "So 54 ÷ 9 = 6."
            ],
            "answer": "6"
          }
        },
        {
          "ref": "ma-g3-mathematics-u03-l03#ex-02",
          "kind": "worked-example",
          "itemType": "property-of-operations",
          "standard": "3.OA.5",
          "difficulty": 2,
          "prompt": "Which expression is equal to 3 × 7 by the commutative property?",
          "workedSolution": {
            "steps": [
              "Changing the order of the factors keeps the same product.",
              "3 × 7 = 7 × 3."
            ],
            "answer": "7 × 3"
          }
        }
