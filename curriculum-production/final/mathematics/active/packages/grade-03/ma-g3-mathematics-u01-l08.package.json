      "directions": "Each example shows a common mistake, then the correction. Read both parts.",
      "items": [
        {
          "ref": "ma-g3-mathematics-u01-l08#ex-01",
          "kind": "worked-example",
          "itemType": "add-within-1000",
          "standard": "3.NBT.2",
          "difficulty": 1,
          "prompt": "A bakery made 248 rolls, then made 175 more. How many rolls in all?",
          "workedSolution": {
            "steps": [
              "248 + 175.",
              "Add ones: 8 + 5 = 13, regroup 1 ten.",
              "Add tens: 4 + 7 + 1 = 12, regroup 1 hundred.",
              "Add hundreds: 2 + 1 + 1 = 4.",
              "Total: 423."
            ],
            "answer": "423"
          }
        },
        {
          "ref": "ma-g3-mathematics-u01-l08#ex-02",
          "kind": "worked-example",
          "itemType": "subtract-within-1000",
          "standard": "3.NBT.2",
          "difficulty": 2,
          "prompt": "A farm had 512 apples. 168 apples were sold. How many apples are left?",
          "workedSolution": {
            "steps": [
              "512 − 168.",
              "Regroup a ten to subtract the ones: 12 − 8 = 4.",
              "Regroup a hundred to subtract the tens: 10 − 6 = 4.",
              "Subtract hundreds: 4 − 1 = 3.",
              "Difference: 344."
            ],
            "answer": "344"
          }
        }
      ]
    },
