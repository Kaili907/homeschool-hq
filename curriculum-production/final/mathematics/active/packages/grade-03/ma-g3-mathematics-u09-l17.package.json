          "standard": "3.MD.7",
          "difficulty": 2,
          "prompt": "A rectangle 5 units long is split into a 3-unit part and a 2-unit part. Find the total area.",
          "workedSolution": {
            "steps": [
              "5 × 3 = 15.",
              "5 × 2 = 10.",
              "15 + 10 = 25."
            ],
            "answer": "25"
