          "difficulty": 1,
          "prompt": "A rectangular garden bed is 6 ft long and 3 ft wide. What is its area?",
          "workedSolution": {
            "steps": [
              "Area = length × width.",
              "6 × 3 = 18.",
              "The area is 18 square feet."
            ],
            "answer": "18 sq ft"
          }
        },
        {
