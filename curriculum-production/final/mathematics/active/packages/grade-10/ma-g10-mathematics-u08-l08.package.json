      "directions": "These two examples show the same idea in two different formats.",
      "items": [
        {
          "ref": "ma-g10-mathematics-u08-l08#ex-01",
          "kind": "worked-example",
          "itemType": "arc-length-and-sector-area",
          "standard": "G-C.5",
          "difficulty": 1,
          "prompt": "Radius 6, central angle 60°. Arc and sector?",
          "workedSolution": {
            "steps": [
              "Fraction is 60/360 = 1/6.",
              "Arc = (1/6)(12π) = 2π; sector = (1/6)(36π) = 6π."
            ],
            "answer": "arc 2π; sector 6π"
          }
        },
        {
          "ref": "ma-g10-mathematics-u08-l08#ex-02",
          "kind": "worked-example",
          "itemType": "cyclic-quadrilateral-angle",
          "standard": "G-C.3",
          "difficulty": 2,
          "prompt": "A cyclic quadrilateral has an angle of 85°. Opposite angle?",
          "workedSolution": {
            "steps": [
              "Opposite angles are supplementary.",
              "180 − 85 = 95°."
            ],
            "answer": "95°"
          }
        }
      ]
    },
