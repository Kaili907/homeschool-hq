          "difficulty": 1,
          "prompt": "Mass 48 g, volume 6 cm³. Density and float?",
          "workedSolution": {
            "steps": [
              "48 ÷ 6 = 8 g/cm³.",
              "8 > 1, so it sinks."
            ],
            "answer": "8 g/cm³; it would sink"
