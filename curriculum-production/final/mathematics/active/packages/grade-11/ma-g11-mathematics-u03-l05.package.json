          "standard": "N-CN.2",
          "difficulty": 1,
          "prompt": "Multiply (2 + 3i)(1 − 4i).",
          "workedSolution": {
            "steps": [
              "2 − 8i + 3i − 12i².",
              "i² = −1 gives 2 + 12 − 5i.",
              "14 − 5i."
            ],
            "answer": "14 − 5i"
          }
        },
        {
          "ref": "ma-g11-mathematics-u03-l05#ex-02",
