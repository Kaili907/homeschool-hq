          "standard": "N-CN.7",
          "difficulty": 2,
          "prompt": "Solve x² − 4x + 13 = 0.",
          "workedSolution": {
            "steps": [
              "Discriminant 16 − 52 = −36.",
              "x = (4 ± 6i)/2 = 2 ± 3i."
            ],
            "answer": "x = 2 + 3i or x = 2 − 3i"
          }
        }
