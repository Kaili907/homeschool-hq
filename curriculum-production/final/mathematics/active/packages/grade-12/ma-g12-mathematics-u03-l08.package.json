          "standard": "G-SRT.9",
          "difficulty": 1,
          "prompt": "a = 8, b = 5, enclosed angle 30°. Area?",
          "workedSolution": {
            "steps": [
              "Area = ½(8)(5)sin30°.",
              "= ½(8)(5)(0.5) = 10."
            ],
            "answer": "10"
          }
