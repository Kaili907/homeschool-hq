          "standard": "A-SSE.1",
          "difficulty": 1,
          "prompt": "Does 3(x² + 2x + 4) expand to 3x² + 6x + 12?",
          "workedSolution": {
            "steps": [
              "3·x² = 3x², 3·2x = 6x, 3·4 = 12.",
              "All three terms match, so yes."
            ],
            "answer": "Yes, the expansion is correct."
          }
        }
      ]
