          "standard": "N-RN.1",
          "difficulty": 2,
          "prompt": "Rewrite ³√(x⁴) using a rational exponent.",
          "workedSolution": {
            "steps": [
              "The index 3 is the denominator and the power 4 is the numerator.",
              "³√(x⁴) = x^(4/3)."
            ],
            "answer": "x^(4/3)"
          }
        }
