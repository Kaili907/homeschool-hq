      "items": [
        {
          "ref": "ma-g9-mathematics-u06-l02#ex-01",
          "kind": "worked-example",
          "itemType": "write-constraint-inequality",
          "standard": "A-CED.3",
          "difficulty": 1,
          "prompt": "A costs $4, B costs $7, budget $50. Write the constraint.",
          "workedSolution": {
            "steps": [
              "Total spend is 4a + 7b.",
              "\"At most\" gives ≤.",
              "4a + 7b ≤ 50."
            ],
            "answer": "4a + 7b ≤ 50"
          }
        },
        {
          "ref": "ma-g9-mathematics-u06-l02#ex-02",
          "kind": "worked-example",
          "itemType": "solve-model-for-required-value",
          "standard": "A-CED.1",
          "difficulty": 2,
          "prompt": "A tank holds 50 L and fills at 8 L/min. When does it hold 130 L?",
          "workedSolution": {
            "steps": [
              "50 + 8m = 130.",
              "8m = 80, so m = 10 minutes."
            ],
            "answer": "10 minutes"
          }
        }
      ]
