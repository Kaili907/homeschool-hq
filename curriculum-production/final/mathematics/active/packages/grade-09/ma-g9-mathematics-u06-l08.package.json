          "difficulty": 2,
          "prompt": "A $40 fee plus $15 per hour totals $115. Write the equation.",
          "workedSolution": {
            "steps": [
              "Fee is constant; hourly rate multiplies h.",
              "40 + 15h = 115."
            ],
            "answer": "40 + 15h = 115"
          }
