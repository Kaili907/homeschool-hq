          "standard": "A-REI.10",
          "difficulty": 2,
          "prompt": "Is (2, 7) on the graph of y = 3x + 1?",
          "workedSolution": {
            "steps": [
              "Substitute x = 2: y = 3(2) + 1 = 7.",
              "That matches, so yes."
            ],
            "answer": "Yes; the coordinates satisfy the equation."
          }
