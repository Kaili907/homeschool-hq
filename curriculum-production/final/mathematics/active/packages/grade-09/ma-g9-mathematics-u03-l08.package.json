          "standard": "A-REI.1",
          "difficulty": 1,
          "prompt": "Why may 2(x + 3) = 10 be rewritten as 2x + 6 = 10?",
          "workedSolution": {
            "steps": [
              "The left side was expanded over the sum.",
              "That is licensed by the distributive property."
            ],
            "answer": "the distributive property"
          }
        },
        {
