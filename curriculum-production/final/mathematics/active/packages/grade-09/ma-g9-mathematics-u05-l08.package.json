          "standard": "A-SSE.3",
          "difficulty": 1,
          "prompt": "Which form shows the zeros of a quadratic immediately?",
          "workedSolution": {
            "steps": [
              "A product is zero exactly when one factor is zero.",
              "Factored form exposes that."
            ],
            "answer": "factored form"
          }
        },
