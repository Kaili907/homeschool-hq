          "standard": "A-REI.4",
          "difficulty": 2,
          "prompt": "Solve x² − 5x + 6 = 0.",
          "workedSolution": {
            "steps": [
              "Factors: (x − 2)(x − 3) = 0.",
              "Each factor zero gives x = 2 or x = 3."
            ],
            "answer": "x = 2 or x = 3"
          }
        }
      ]
