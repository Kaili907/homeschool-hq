          "standard": "A-REI.4",
          "difficulty": 2,
          "prompt": "Solve x² + 3x + 1 = 0 exactly.",
          "workedSolution": {
            "steps": [
              "Discriminant 9 − 4 = 5.",
              "x = (−3 ± √5)/2."
            ],
            "answer": "x = (−3 ± √5) / 2"
          }
        }
