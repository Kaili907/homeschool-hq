          "kind": "worked-example",
          "itemType": "compare-scientific-notation",
          "standard": "8.EE.3",
          "difficulty": 1,
          "prompt": "Compare 3.2 × 10^5 and 4.1 × 10^-2.",
          "workedSolution": {
            "steps": [
              "A larger power of ten always makes a number larger when the coefficient is between 1 and 10.",
              "5 > -2, so 3.2 × 10^5 is greater."
            ],
            "answer": "3.2 × 10^5 > 4.1 × 10^-2"
          }
        }
      ]
