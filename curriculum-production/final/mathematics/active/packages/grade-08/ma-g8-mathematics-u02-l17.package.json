      "items": [
        {
          "ref": "ma-g8-mathematics-u02-l17#ex-01",
          "kind": "worked-example",
          "itemType": "scientific-notation-word-problem",
          "standard": "8.EE.4",
          "difficulty": 1,
          "prompt": "A processor performs 6 × 10^9 operations per second. How many operations does it perform in 5 × 10^2 seconds? Write the answer in scientific notation.",
          "workedSolution": {
            "steps": [
              "Multiply the coefficients: 6 × 5 = 30.",
              "Add the exponents: 9 + 2 = 11.",
              "30 × 10^11 = 3 × 10^12."
            ],
            "answer": "3 × 10^12"
          }
        },
        {
          "ref": "ma-g8-mathematics-u02-l17#ex-02",
          "kind": "worked-example",
          "itemType": "extreme-quantities-word-problem",
          "standard": "8.EE.4",
          "difficulty": 2,
          "prompt": "A cell has a diameter of about 8 × 10^-5 meters. A virus has a diameter of about 2 × 10^-8 meters. How many times as large is the cell as the virus?",
          "workedSolution": {
            "steps": [
              "Divide the coefficients: 8 ÷ 2 = 4.",
              "Subtract the exponents: -5 - (-8) = 3."
            ],
            "answer": "4 × 10^3"
          }
        }
      ]
    },
