          "standard": "8.EE.2",
          "difficulty": 1,
          "prompt": "Solve x² = 36. Write the exact solution or solutions using root notation.",
          "workedSolution": {
            "steps": [
              "x² = 36 asks which number multiplied by itself gives 36.",
              "For a positive p, x² = p has two real solutions: x = √p and x = −√p.",
              "√36 = 6 because 6² = 36, and (−6)² = 36 as well."
            ],
            "answer": "x = 6 or x = −6"
          }
        },
        {
          "ref": "ma-g8-mathematics-u01-l19#ex-02",
          "kind": "worked-example",
          "itemType": "solve-x-cubed-equals-p",
          "standard": "8.EE.2",
          "difficulty": 1,
          "prompt": "Solve x³ = 8. Write the exact solution using root notation.",
          "workedSolution": {
            "steps": [
              "x³ = 8 asks which number multiplied by itself three times gives 8.",
              "Cubing keeps the sign of a number, so only one real number cubes to 8.",
              "∛8 = 2 because 2³ = 8."
            ],
            "answer": "x = 2"
          }
        }
      ]
