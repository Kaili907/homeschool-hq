      "title": "Instructional examples",
      "directions": "Study both examples. The second one drops some of the wording of the first.",
      "items": [
        {
          "ref": "ma-g8-mathematics-u01-l02#ex-01",
          "kind": "worked-example",
          "itemType": "repeating-decimal-to-fraction",
          "standard": "8.NS.1",
          "difficulty": 1,
          "prompt": "Write 0.454545... as a fraction in lowest terms.",
          "workedSolution": {
            "steps": [
              "The repeating block is \"45\", which has length 2.",
              "Write the fraction as 45/99.",
              "Reduce by the greatest common factor, 9, to get 5/11."
            ],
            "answer": "5/11"
          }
        },
        {
          "ref": "ma-g8-mathematics-u01-l02#ex-02",
          "kind": "worked-example",
          "itemType": "repeating-decimal-error-analysis",
          "standard": "8.NS.1",
          "difficulty": 2,
          "prompt": "A student writes 0.6666... = 6/10. Which statement best analyzes the claim?",
          "workedSolution": {
            "steps": [
              "The repeating block \"6\" has length 1, so the denominator should be 10¹ - 1 = 9.",
              "6/9 reduces to 2/3."
            ],
            "answer": "The correct fraction is 2/3; the denominator should be 9 (one 9 for each repeating digit), not 10."
          }
        }
      ]
    },
