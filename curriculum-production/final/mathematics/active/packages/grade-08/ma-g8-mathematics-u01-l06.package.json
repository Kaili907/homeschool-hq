          "difficulty": 1,
          "prompt": "A square garden has an area of 73 square meters. Between which two consecutive whole numbers of meters is the side length?",
          "workedSolution": {
            "steps": [
              "The side length is √73 meters.",
              "8² = 64 and 9² = 81, and 64 < 73 < 81, so the side length is between 8 and 9 meters."
            ],
            "answer": "8 and 9"
          }
        }
      ]
