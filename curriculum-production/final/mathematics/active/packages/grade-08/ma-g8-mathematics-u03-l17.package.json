          "kind": "worked-example",
          "itemType": "solve-word-problem",
          "standard": "8.EE.7",
          "difficulty": 2,
          "prompt": "A bike rental costs $5 plus $3 per hour. If the total cost was $20, how many hours, x, were rented?",
          "workedSolution": {
            "steps": [
              "The equation is 3x + 5 = 20.",
              "Subtract 5: 3x = 15.",
              "Divide by 3: x = 5."
            ],
            "answer": "5"
          }
        }
      ]
