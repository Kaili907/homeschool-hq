          "standard": "8.NS.2",
          "difficulty": 1,
          "prompt": "Between which two consecutive whole numbers does √73 lie?",
          "workedSolution": {
            "steps": [
              "8² = 64 and 9² = 81.",
              "64 < 73 < 81, so 8 < √73 < 9."
            ],
            "answer": "8 and 9"
