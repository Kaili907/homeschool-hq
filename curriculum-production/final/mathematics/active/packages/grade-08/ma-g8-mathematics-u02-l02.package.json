          "standard": "8.EE.1",
          "difficulty": 2,
          "prompt": "Evaluate 10^-3.",
          "workedSolution": {
            "steps": [
              "A negative exponent moves the 1 to the right of the decimal point.",
              "10^-3 = 1/1000 = 0.001."
            ],
            "answer": "0.001"
          }
        }
