          "itemType": "slope-from-two-points",
          "standard": "8.EE.5",
          "difficulty": 1,
          "prompt": "Find the slope of the line through (2, 3) and (6, 11).",
          "workedSolution": {
            "steps": [
              "The change in y is 11 - 3 = 8.",
              "The change in x is 6 - 2 = 4.",
              "Slope = rise/run = 8/4 = 2."
            ],
            "answer": "2"
          }
        }
      ]
