          "standard": "4.NBT.4",
          "difficulty": 2,
          "prompt": "A stadium holds 62,000 seats. 47,318 seats were filled. How many were empty?",
          "workedSolution": {
            "steps": [
              "62,000 − 47,318.",
              "Regroup across the zeros as needed.",
              "Difference: 14,682."
            ],
            "answer": "14682"
          }
        }
