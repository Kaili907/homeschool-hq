      "title": "Instructional examples",
      "directions": "Compare these two examples. Find the step where they stop being the same.",
      "items": [
        {
          "ref": "ma-g4-mathematics-u07-l03#ex-01",
          "kind": "worked-example",
          "itemType": "add-subtract-fractions-same-denominator",
          "standard": "4.NF.3",
          "difficulty": 1,
          "prompt": "Find 5/8 − 2/8.",
          "workedSolution": {
            "steps": [
              "Denominators match, subtract numerators: 5 − 2 = 3.",
              "3/8 is already in lowest terms."
            ],
            "answer": "3/8"
          }
        },
        {
          "ref": "ma-g4-mathematics-u07-l03#ex-02",
          "kind": "worked-example",
          "itemType": "decompose-fraction-as-sum",
          "standard": "4.NF.3",
          "difficulty": 2,
          "prompt": "Write 7/3 as a whole number plus a fraction less than 1.",
          "workedSolution": {
            "steps": [
              "3/3 makes one whole. 7 ÷ 3 = 2 remainder 1.",
              "7/3 = 2 and 1/3."
            ],
            "answer": "2 1/3"
          }
        }
      ]
