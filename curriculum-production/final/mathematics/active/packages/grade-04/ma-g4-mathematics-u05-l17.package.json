          "itemType": "division-with-remainder",
          "standard": "4.NBT.6",
          "difficulty": 1,
          "prompt": "Find 53 ÷ 6.",
          "workedSolution": {
            "steps": [
              "6 × 8 = 48.",
              "53 − 48 = 5, and 5 is less than 6.",
              "53 ÷ 6 = 8 remainder 5."
            ],
            "answer": "8 r5"
          }
        },
        {
          "ref": "ma-g4-mathematics-u05-l17#ex-02",
          "kind": "worked-example",
          "itemType": "interpret-remainder-in-word-problem",
          "standard": "4.OA.3",
          "difficulty": 2,
          "prompt": "29 students need vans that hold 8 students each. How many vans are needed?",
          "workedSolution": {
            "steps": [
              "29 ÷ 8 = 3 remainder 5.",
              "The 5 leftover students still need a van.",
              "4 vans are needed."
            ],
            "answer": "4"
          }
        }
      ]
