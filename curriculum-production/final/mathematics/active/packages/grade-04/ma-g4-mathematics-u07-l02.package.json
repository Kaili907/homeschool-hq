          "standard": "4.NF.3",
          "difficulty": 2,
          "prompt": "Write 7/3 as a whole number plus a fraction less than 1.",
          "workedSolution": {
            "steps": [
              "3/3 makes one whole. 7 ÷ 3 = 2 remainder 1.",
              "7/3 = 2 and 1/3."
            ],
            "answer": "2 1/3"
