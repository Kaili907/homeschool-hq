          "prompt": "A school raised $3,200 in September and $2,750 in October, then spent $1,400 on new books. How much remains?",
          "workedSolution": {
            "steps": [
              "3,200 + 2,750 = 5,950.",
              "5,950 − 1,400 = 4,550."
            ],
            "answer": "4550"
