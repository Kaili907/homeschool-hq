          "standard": "4.NBT.1",
          "difficulty": 1,
          "prompt": "The digit 3 is in the thousands place in one number, and the digit 3 is in the hundreds place in another. How many times as great is the first?",
          "workedSolution": {
            "steps": [
              "Thousands is one place left of hundreds.",
              "Each place is 10 times the place to its right.",
              "The first digit is 10 times as great."
            ],
            "answer": "10"
          }
        }
      ]
