          "difficulty": 1,
          "prompt": "Find 53 ÷ 6.",
          "workedSolution": {
            "steps": [
              "6 × 8 = 48.",
              "53 − 48 = 5, and 5 is less than 6.",
              "53 ÷ 6 = 8 remainder 5."
            ],
            "answer": "8 r5"
          }
        }
      ]
