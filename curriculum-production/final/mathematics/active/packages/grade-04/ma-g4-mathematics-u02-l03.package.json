          "standard": "4.NBT.4",
          "difficulty": 1,
          "prompt": "A theater sold 24,861 tickets in week one and 18,957 in week two. How many total?",
          "workedSolution": {
            "steps": [
              "24,861 + 18,957.",
              "Add each place, regrouping as needed.",
              "Total: 43,818."
            ],
            "answer": "43818"
          }
        },
        {
          "ref": "ma-g4-mathematics-u02-l03#ex-02",
