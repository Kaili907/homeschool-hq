          "standard": "5.G.3",
          "difficulty": 2,
          "prompt": "Lines that meet to form a right angle are called what?",
          "workedSolution": {
            "steps": [
              "A right angle measures 90 degrees.",
              "Those lines are perpendicular."
            ],
            "answer": "perpendicular"
