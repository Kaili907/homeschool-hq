          "standard": "5.NF.1",
          "difficulty": 1,
          "prompt": "Find 2/3 + 3/4. Write the answer in simplest form.",
          "workedSolution": {
            "steps": [
              "Use 12 as a common denominator: 2/3 = 8/12 and 3/4 = 9/12.",
              "Add: 8/12 + 9/12 = 17/12.",
              "Rewrite and simplify 17/12 as 1 5/12."
            ],
            "answer": "1 5/12"
          }
        }
