          "standard": "5.NBT.5",
          "difficulty": 1,
          "prompt": "A booth sells 28 tickets each day for 3 days at $6 per ticket. What is the projected revenue?",
          "workedSolution": {
            "steps": [
              "Find the number of tickets: 28 × 3 = 84.",
              "Multiply the tickets by the price: 84 × 6.",
              "The projected revenue is $504."
            ],
            "answer": "$504"
          }
        },
        {
          "ref": "ma-g5-mathematics-u03-l05#ex-02",
          "kind": "worked-example",
          "itemType": "multiplicative-comparison",
          "standard": "5.OA.2",
          "difficulty": 2,
          "prompt": "Nia has 6 times as many beads as Eli. Eli has 14 beads. How many beads does Nia have?",
          "workedSolution": {
            "steps": [
              "“6 times as many” means multiply Eli’s amount by 6.",
              "Write 6 × 14.",
              "6 × 14 = 84, so Nia has 84 beads."
            ],
            "answer": "84"
          }
        }
