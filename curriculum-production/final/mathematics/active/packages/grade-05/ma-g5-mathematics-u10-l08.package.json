          "itemType": "scale-project",
          "standard": "5.NF.4",
          "difficulty": 1,
          "prompt": "A 3/4-meter path is scaled by 2. What length?",
          "workedSolution": {
            "steps": [
              "Multiply: 3/4 × 2 = 6/4.",
              "Simplify 6/4 to 1 1/2."
            ],
            "answer": "1 1/2"
          }
        },
        {
          "ref": "ma-g5-mathematics-u10-l08#ex-02",
          "kind": "worked-example",
          "itemType": "volume-plan",
          "standard": "5.MD.5",
          "difficulty": 2,
          "prompt": "A box is 4 by 3 by 2 unit cubes. What is its volume?",
          "workedSolution": {
            "steps": [
              "Multiply length × width × height.",
              "4 × 3 × 2 = 24."
            ],
            "answer": "24 cubic units"
          }
        }
      ]
