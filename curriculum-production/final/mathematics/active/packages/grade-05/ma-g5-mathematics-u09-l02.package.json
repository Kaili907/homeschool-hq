          "difficulty": 1,
          "prompt": "The library is at x = 4 and y = 2. What point names it?",
          "workedSolution": {
            "steps": [
              "Use horizontal distance for x.",
              "Use vertical distance for y."
            ],
            "answer": "(4, 2)"
          }
        },
        {
          "ref": "ma-g5-mathematics-u09-l02#ex-02",
          "kind": "worked-example",
          "itemType": "classify-shape-properties",
          "standard": "5.G.3",
          "difficulty": 2,
          "prompt": "A quadrilateral has 4 right angles and 2 pairs of parallel sides. What is it?",
          "workedSolution": {
            "steps": [
              "Four right angles fit a rectangle.",
              "Its opposite sides are parallel."
            ],
            "answer": "rectangle"
          }
        }
