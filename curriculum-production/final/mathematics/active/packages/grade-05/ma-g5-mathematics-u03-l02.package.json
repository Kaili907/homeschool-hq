          "difficulty": 1,
          "prompt": "Use partial products to calculate 326 × 24.",
          "workedSolution": {
            "steps": [
              "Decompose 326 as 300 + 20 + 6 and 24 as 20 + 4.",
              "The partial products are 6000, 1200, 400, 80, 120, and 24.",
              "Add all partial products to get 7824."
            ],
            "answer": "7824"
          }
        },
        {
