          "difficulty": 1,
          "prompt": "Use the partial quotients 40 and 7 to solve 799 ÷ 17.",
          "workedSolution": {
            "steps": [
              "Subtract 17 × 40 = 680 from 799 to leave 119.",
              "Subtract 17 × 7 = 119 to leave 0.",
              "Add the partial quotients: 40 + 7 = 47."
            ],
            "answer": "47"
          }
