          "standard": "5.OA.1",
          "difficulty": 1,
          "prompt": "Evaluate {18 + [6 × (9 - 4)]}.",
          "workedSolution": {
            "steps": [
              "Evaluate the innermost grouping first: 9 - 4 = 5.",
              "Multiply inside the brackets: 6 × 5 = 30.",
              "Add inside the braces: 18 + 30 = 48."
            ],
            "answer": "48"
          }
        }
