          "itemType": "add-mixed-numbers",
          "standard": "5.NF.1",
          "difficulty": 1,
          "prompt": "Find 1 2/3 + 2 3/4. Write the answer in simplest form.",
          "workedSolution": {
            "steps": [
              "Add the whole numbers: 1 + 2 = 3.",
              "Add the fractions: 2/3 + 3/4 = 17/12 = 1 5/12.",
              "Combine the parts: 3 + 1 5/12 = 4 5/12."
            ],
            "answer": "4 5/12"
          }
        }
