      "kind": "instructional-example",
      "title": "Instructional examples",
      "directions": "Study both examples. The second one drops some of the wording of the first.",
      "items": [
        {
          "ref": "ma-g5-mathematics-u07-l02#ex-01",
          "kind": "worked-example",
          "itemType": "decimal-multiplication",
          "standard": "5.NBT.7",
          "difficulty": 1,
          "prompt": "Find 1.2 × 3.",
          "workedSolution": {
            "steps": [
              "Ignore the decimal point at first and multiply whole numbers: 12 × 3 = 36.",
              "Count the decimal places in the factors: 1.2 has one and 3 has none, so the product needs one.",
              "Count one digit from the right of 36 and place the point there: 1.2 × 3 = 3.6."
            ],
            "answer": "3.6"
          }
        },
        {
          "ref": "ma-g5-mathematics-u07-l02#ex-02",
          "kind": "worked-example",
          "itemType": "decimal-division",
          "standard": "5.NBT.7",
          "difficulty": 2,
          "prompt": "Find 4.8 ÷ 3.",
          "workedSolution": {
            "steps": [
              "Divide the ones first: 4 ÷ 3 = 1 with 1 one left over.",
              "That leftover one is 10 tenths; with the 8 tenths already there that makes 18 tenths, and 18 ÷ 3 = 6 tenths.",
              "Keep the decimal point directly above its place in 4.8: the quotient is 1.6."
            ],
            "answer": "1.6"
          }
        }
      ]
    },
