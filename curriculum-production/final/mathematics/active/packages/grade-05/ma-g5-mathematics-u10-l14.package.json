          "standard": "MP.4",
          "difficulty": 1,
          "prompt": "A student says a 4 by 3 by 2 box has volume 9. Is the claim correct?",
          "workedSolution": {
            "steps": [
              "Volume uses all three dimensions.",
              "4 × 3 × 2 = 24, not 9."
            ],
            "answer": "No; the volume is 24 cubic units."
