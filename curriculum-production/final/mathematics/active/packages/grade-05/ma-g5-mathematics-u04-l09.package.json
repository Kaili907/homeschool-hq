          "difficulty": 1,
          "prompt": "Find 938 ÷ 18. Write the quotient and remainder.",
          "workedSolution": {
            "steps": [
              "18 × 52 = 936.",
              "938 - 936 = 2, so the remainder is 2.",
              "Check that 938 = 18 × 52 + 2 and that 2 is less than 18."
            ],
            "answer": "52 R 2"
