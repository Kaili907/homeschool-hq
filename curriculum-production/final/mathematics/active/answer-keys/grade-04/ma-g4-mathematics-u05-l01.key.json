      "answerType": "fixed",
      "answer": "64 r3",
      "answerIndex": 2,
      "given": {
        "divisor": 4,
        "quotient": 64,
        "remainder": 3
      },
      "solutionReasoning": {
        "steps": [
          "4 × 64 = 256.",
          "259 − 256 = 3, and 3 is less than 4.",
          "So 259 ÷ 4 = 64 remainder 3."
        ],
        "answer": "64 r3"
      },
      "referenceExample": {
        "prompt": "Find 53 ÷ 6.",
        "steps": [
          "6 × 8 = 48.",
          "53 − 48 = 5, and 5 is less than 6.",
          "53 ÷ 6 = 8 remainder 5."
        ],
        "answer": "8 r5"
      },
      "verification": {
