      "answer": "30 r1",
      "answerIndex": 3,
      "given": {
        "divisor": 3,
        "quotient": 30,
        "remainder": 1
      },
      "solutionReasoning": {
        "steps": [
          "3 × 30 = 90.",
          "91 − 90 = 1, and 1 is less than 3.",
          "So 91 ÷ 3 = 30 remainder 1."
        ],
        "answer": "30 r1"
      },
      "referenceExample": {
        "prompt": "Find 53 ÷ 6.",
        "steps": [
          "6 × 8 = 48.",
          "53 − 48 = 5, and 5 is less than 6.",
          "53 ÷ 6 = 8 remainder 5."
        ],
        "answer": "8 r5"
      },
      "verification": {
