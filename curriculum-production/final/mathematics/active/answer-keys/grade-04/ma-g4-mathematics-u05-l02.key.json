      },
      "solutionReasoning": {
        "steps": [
          "3 × 43 = 129.",
          "131 − 129 = 2, and 2 is less than 3.",
          "So 131 ÷ 3 = 43 remainder 2."
        ],
        "answer": "43 r2"
      },
      "referenceExample": {
        "prompt": "Find 53 ÷ 6.",
        "steps": [
          "6 × 8 = 48.",
          "53 − 48 = 5, and 5 is less than 6.",
          "53 ÷ 6 = 8 remainder 5."
        ],
        "answer": "8 r5"
      },
      "verification": {
