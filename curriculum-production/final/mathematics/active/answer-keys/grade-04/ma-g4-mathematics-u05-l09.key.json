        "quotient": 12,
        "remainder": 1
      },
      "solutionReasoning": {
        "steps": [
          "4 × 12 = 48.",
          "49 − 48 = 1, and 1 is less than 4.",
          "So 49 ÷ 4 = 12 remainder 1."
        ],
        "answer": "12 r1"
      },
      "referenceExample": {
        "prompt": "Find 53 ÷ 6.",
