{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../..",
    "outDir": ".dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "../../core/schema/**/*.ts",
    "../../core/v2/contracts/**/*.ts",
    "../../core/v3/**/*.ts",
    "../../study-engine/tutor-v2/parent-reporting/**/*.ts",
    "../../study-engine/tutor-v2/wave3/**/*.ts",
    "../../evals/v3/**/*.ts",
    "../../tests/tutor-v3-convergence/**/*.ts",
    "./**/*.ts"
  ]
}
