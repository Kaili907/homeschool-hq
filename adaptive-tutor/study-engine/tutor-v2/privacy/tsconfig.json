{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "types": ["node"],
    "rootDir": "../../.."
  },
  "include": [
    "../../../core/schema/**/*.ts",
    "../../../core/v2/contracts/**/*.ts",
    "./**/*.ts",
    "../evidence/**/*.ts"
  ]
}
