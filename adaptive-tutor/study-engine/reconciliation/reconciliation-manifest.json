      "id": "R1-R01",
      "classification": "REQUIRED BEFORE FINAL ASSEMBLY",
      "summary": "Move Session 4 private note bodies to Session 1 authorized private records and retain only privateRecordRef in controls."
    },
    {
      "id": "R1-R02",
      "classification": "REQUIRED BEFORE FINAL ASSEMBLY",
      "summary": "Route every inbound version through Session 1 inspect/migrate/quarantine without destructive fallback."
    },
    {
      "id": "R1-A01",
      "classification": "SAFE ADAPTER",
      "summary": "Deterministic mappings for grade bands, presentation timers, break reasons, review intervals and Session 4 projections."
    },
    {
      "id": "R1-D01",
      "classification": "DOCUMENTATION ONLY",
      "summary": "Frozen Tutor Core remains persistence-agnostic; refresh persistence belongs to the Study checkpoint/sidecar."
    },
    {
      "id": "R1-P01",
      "classification": "DEFERRED PRODUCTION CONCERN",
      "summary": "Authorization, encryption, retention/deletion, deployment and production external side effects remain out of scope."
    }
