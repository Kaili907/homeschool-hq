{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "skillId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Lowercase ASCII stable content identifier."
    },
    "value": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lowerBound": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "upperBound": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "effectiveEvidence": {
      "type": "number",
      "minimum": 0
    },
    "distinctContextCount": {
      "type": "integer",
      "minimum": 0
    },
    "band": {
      "anyOf": [
        {
          "const": "very-low",
          "type": "string"
        },
        {
          "const": "low",
          "type": "string"
        },
        {
          "const": "developing",
          "type": "string"
        },
        {
          "const": "strong",
          "type": "string"
        },
        {
          "const": "insufficient-evidence",
          "type": "string"
        }
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "placementDecisionAllowed": {
      "const": false,
      "type": "boolean"
    }
  },
  "required": [
    "skillId",
    "value",
    "uncertainty",
    "lowerBound",
    "upperBound",
    "evidenceCount",
    "effectiveEvidence",
    "distinctContextCount",
    "band",
    "explanation",
    "placementDecisionAllowed"
  ],
  "additionalProperties": false,
  "$id": "ConfidenceEstimate"
}
