{
  "name": "@manuel-academy/adaptive-study-engine-runtime",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Portable non-production composition runtime for the Manuel Academy Adaptive Study Engine.",
  "exports": {
    ".": "./src/index.ts",
    "./student": "./src/student.ts",
    "./calendar": "./src/calendar.ts",
    "./parent": "./src/parent.ts",
    "./review": "./src/review.ts",
    "./tutor-bridge": "./src/tutor-bridge.ts",
    "./checkpoint": "./src/checkpoint.ts",
    "./outbox": "./src/outbox.ts",
    "./safety": "./src/safety.ts",
    "./adult-review": "./src/adult-review.ts",
    "./romeo": "./src/romeo.ts",
    "./health": "./src/health.ts"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --configLoader runner",
    "test:browser": "playwright test",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "generate:traces": "node scripts/run-tsx.cjs scripts/generate-traces.ts",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "test:all": "npm run typecheck && npm run test && npm run test:browser && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.54.1",
    "@types/node": "22.15.32",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
