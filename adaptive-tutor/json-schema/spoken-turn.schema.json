{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Lowercase ASCII stable content identifier."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20,
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "pace": {
      "anyOf": [
        {
          "const": "slow",
          "type": "string"
        },
        {
          "const": "normal",
          "type": "string"
        },
        {
          "const": "brisk",
          "type": "string"
        }
      ]
    },
    "emphasisTokens": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "maxItems": 20
    },
    "canInterrupt": {
      "type": "boolean"
    },
    "requireLearnerResponse": {
      "type": "boolean"
    },
    "fallbackText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    },
    "captionsRequired": {
      "const": true,
      "type": "boolean"
    },
    "transcriptRequired": {
      "const": true,
      "type": "boolean"
    },
    "claimsHumanIdentity": {
      "const": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "text",
    "locale",
    "pace",
    "emphasisTokens",
    "canInterrupt",
    "requireLearnerResponse",
    "fallbackText",
    "captionsRequired",
    "transcriptRequired",
    "claimsHumanIdentity"
  ],
  "additionalProperties": false,
  "$id": "SpokenTurn"
}
