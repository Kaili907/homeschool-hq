{
  "$id": "TutorV2TelemetryEnvelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "explain",
              "type": "string"
            },
            {
              "const": "hint",
              "type": "string"
            },
            {
              "const": "ask-check",
              "type": "string"
            },
            {
              "const": "show-example",
              "type": "string"
            },
            {
              "const": "reteach",
              "type": "string"
            },
            {
              "const": "check-prerequisite",
              "type": "string"
            },
            {
              "const": "suggest-break",
              "type": "string"
            },
            {
              "const": "escalate",
              "type": "string"
            },
            {
              "const": "return-to-lesson",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "actionCompatibilityId": {
      "const": "manuel-academy.study-tutor-v2.action.v1",
      "type": "string"
    },
    "actionSchemaVersion": {
      "const": 1,
      "type": "number"
    },
    "compatibilityId": {
      "const": "manuel-academy.study-tutor-v2.contracts.v2",
      "type": "string"
    },
    "contractVersion": {
      "const": "2.0.0",
      "type": "string"
    },
    "costUnits": {
      "minimum": 0,
      "type": "integer"
    },
    "inputTokenCount": {
      "minimum": 0,
      "type": "integer"
    },
    "interactionRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "latencyMs": {
      "minimum": 0,
      "type": "integer"
    },
    "modelRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "outcomeCode": {
      "anyOf": [
        {
          "const": "ACTION_PROPOSED",
          "type": "string"
        },
        {
          "const": "ACTION_ACCEPTED",
          "type": "string"
        },
        {
          "const": "POLICY_REJECTION",
          "type": "string"
        },
        {
          "const": "PROVIDER_UNAVAILABLE",
          "type": "string"
        },
        {
          "const": "PROVIDER_TIMEOUT",
          "type": "string"
        },
        {
          "const": "MALFORMED_RESPONSE",
          "type": "string"
        },
        {
          "const": "UNSUPPORTED_ACTION",
          "type": "string"
        },
        {
          "const": "SAFETY_STOP",
          "type": "string"
        },
        {
          "const": "STATIC_FALLBACK_REQUIRED",
          "type": "string"
        },
        {
          "const": "INSUFFICIENT_GROUNDED_CONTEXT",
          "type": "string"
        }
      ]
    },
    "outputTokenCount": {
      "minimum": 0,
      "type": "integer"
    },
    "providerRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "telemetryKind": {
      "const": "minimized-operation",
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "actionSchemaVersion",
    "compatibilityId",
    "actionCompatibilityId",
    "telemetryKind",
    "interactionRef",
    "action",
    "providerRef",
    "modelRef",
    "inputTokenCount",
    "outputTokenCount",
    "latencyMs",
    "costUnits",
    "outcomeCode"
  ],
  "title": "Tutor V2 Telemetry Envelope",
  "type": "object"
}
