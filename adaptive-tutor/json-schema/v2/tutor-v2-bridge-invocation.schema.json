                    "agePolicyRef": {
                      "maxLength": 160,
                      "minLength": 3,
                      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
                      "type": "string"
                    },
                    "learnerStageRef": {
                      "maxLength": 160,
                      "minLength": 3,
                      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
                      "type": "string"
                    },
                    "maximumResponseWords": {
                      "maximum": 1000,
                      "minimum": 1,
                      "type": "integer"
