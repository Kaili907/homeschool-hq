          "type": "string"
        },
        "bindingKind": {
          "const": "trusted-study-age-policy-binding",
          "type": "string"
        },
        "learningStageRef": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
          "type": "string"
        },
        "policyProfileRef": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
          "type": "string"
        }
