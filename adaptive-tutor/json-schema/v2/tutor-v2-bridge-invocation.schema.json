                    "responseStyleCode": {
                      "maxLength": 96,
                      "minLength": 3,
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "agePolicyRef",
                    "learnerStageRef",
                    "responseStyleCode",
                    "maximumResponseWords"
