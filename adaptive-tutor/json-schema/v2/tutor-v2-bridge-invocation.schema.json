                  "properties": {
                    "itemRef": {
                      "maxLength": 160,
                      "minLength": 3,
                      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
                      "type": "string"
                    },
                    "learnerResponse": {
                      "maxLength": 4000,
                      "minLength": 1,
                      "type": "string"
                    },
                    "responseFormat": {
                      "maxLength": 96,
                      "minLength": 3,
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "itemRef",
                    "responseFormat",
                    "learnerResponse"
                  ],
                  "type": "object"
                },
                "mode": {
                  "const": "permit-current-attempt",
                  "type": "string"
                },
                "policyPermissionRef": {
                  "maxLength": 160,
                  "minLength": 3,
                  "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
                  "type": "string"
