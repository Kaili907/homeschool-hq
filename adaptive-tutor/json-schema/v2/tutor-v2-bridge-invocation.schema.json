              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "prerequisiteConceptRefs": {
                  "items": {
                    "maxLength": 160,
                    "minLength": 3,
                    "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
                    "type": "string"
                  },
                  "maxItems": 12,
                  "minItems": 1,
                  "type": "array"
                },
                "status": {
                  "const": "recommended",
                  "type": "string"
                }
              },
              "required": [
                "status",
                "prerequisiteConceptRefs"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "assignmentRef": {
                  "maxLength": 160,
                  "minLength": 3,
                  "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
                  "type": "string"
                },
                "prerequisiteConceptRefs": {
                  "items": {
                    "maxLength": 160,
                    "minLength": 3,
                    "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
                    "type": "string"
