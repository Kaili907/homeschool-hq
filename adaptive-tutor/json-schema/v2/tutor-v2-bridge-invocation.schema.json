                  "type": "object"
                }
              },
              "required": [
                "mode",
                "parameters"
              ],
              "type": "object"
            }
          ]
        },
        "learnerAttempt": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "omit",
                  "type": "string"
                }
              },
              "required": [
                "mode"
