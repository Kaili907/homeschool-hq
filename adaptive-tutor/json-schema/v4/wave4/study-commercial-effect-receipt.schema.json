{
  "$id": "StudyCommercialEffectReceipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commercialExecutionScopeRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "conceptRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "contractVersion": {
      "const": "study-tutor-v3.commercial-effect-receipt.v2",
      "type": "string"
    },
    "curriculumCourseRef": {
      "maxLength": 160,
      "minLength": 2,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "curriculumLessonRef": {
      "maxLength": 160,
      "minLength": 2,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "curriculumPackageRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "curriculumReleaseRef": {
      "maxLength": 160,
      "minLength": 2,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "curriculumSubjectRef": {
      "maxLength": 160,
      "minLength": 2,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "curriculumUnitRef": {
      "maxLength": 160,
      "minLength": 2,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "decision": {
      "anyOf": [
        {
          "const": "accepted",
          "type": "string"
        },
        {
          "const": "rejected",
          "type": "string"
        }
      ]
    },
    "effectDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "effectRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "householdScopeRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "interactionRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "invocationRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "issuedBy": {
      "const": "study-engine",
      "type": "string"
    },
    "learnerScopeRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "logicalOperationRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "opportunityRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "receiptKind": {
      "const": "trusted-study-commercial-effect-receipt",
      "type": "string"
    },
    "receiptRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "sessionRef": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]{1,31}:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
      "type": "string"
    },
    "studyProgressCommitted": {
      "type": "boolean"
    },
    "tutorMutationAuthorityGranted": {
      "const": false,
      "type": "boolean"
    }
  },
  "required": [
    "contractVersion",
    "receiptKind",
    "issuedBy",
    "curriculumReleaseRef",
    "curriculumCourseRef",
    "curriculumSubjectRef",
    "curriculumUnitRef",
    "curriculumLessonRef",
    "decision",
    "effectDigest",
    "studyProgressCommitted",
    "tutorMutationAuthorityGranted"
  ],
  "title": "Study Commercial Effect Receipt",
  "type": "object"
}
