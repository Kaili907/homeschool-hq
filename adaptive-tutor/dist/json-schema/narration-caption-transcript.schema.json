{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Lowercase ASCII stable content identifier."
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20,
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "audioUri": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Lowercase ASCII stable content identifier."
          },
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "speaker": {
            "anyOf": [
              {
                "const": "jarvis",
                "type": "string"
              },
              {
                "const": "learner",
                "type": "string"
              },
              {
                "const": "narrator",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "id",
          "startMs",
          "endMs",
          "text",
          "speaker"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 500
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Lowercase ASCII stable content identifier."
          },
          "speaker": {
            "anyOf": [
              {
                "const": "jarvis",
                "type": "string"
              },
              {
                "const": "learner",
                "type": "string"
              },
              {
                "const": "system",
                "type": "string"
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "visibleToLearner": {
            "type": "boolean"
          },
          "containsIdentifyingInformation": {
            "const": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "speaker",
          "text",
          "visibleToLearner",
          "containsIdentifyingInformation"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 500
    },
    "voiceRequired": {
      "const": false,
      "type": "boolean"
    },
    "mediaRequired": {
      "const": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "locale",
    "text",
    "audioUri",
    "captions",
    "transcript",
    "voiceRequired",
    "mediaRequired"
  ],
  "additionalProperties": false,
  "$id": "NarrationCaptionTranscript"
}
