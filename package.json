{
  "name": "homeschool-hq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/stamp-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude adaptive-tutor/** --exclude supabase/** --maxWorkers 1 && vitest run supabase/academy-profiles-base.db.test.ts && vitest run supabase/academy-student-identity.db.test.ts && vitest run supabase/academy-foundation-integration.db.test.ts && vitest run supabase/academy-cas.db.test.ts --testTimeout 120000 && vitest run supabase/academy-cas.postgres.test.ts && npm run test:study-db && npm run test:migrations",
    "test:host": "vitest run --exclude adaptive-tutor/** --exclude supabase/** --maxWorkers 1",
    "test:ai-gateways": "vitest run tests/netlify-functions/anthropic.test.js tests/netlify-functions/tts.test.js --maxWorkers 1",
    "test:study-safety": "vitest run --config netlify/functions/_shared/study-safety/vitest.config.mjs --maxWorkers 1",
    "test:academy-db": "vitest run supabase/academy-profiles-base.db.test.ts && vitest run supabase/academy-student-identity.db.test.ts && vitest run supabase/academy-foundation-integration.db.test.ts && vitest run supabase/academy-cas.db.test.ts --testTimeout 120000 && vitest run supabase/academy-cas.postgres.test.ts",
    "test:academy-db:base": "vitest run supabase/academy-profiles-base.db.test.ts",
    "test:academy-db:identity": "vitest run supabase/academy-student-identity.db.test.ts",
    "test:academy-db:safe-sync": "vitest run supabase/academy-cas.db.test.ts --testTimeout 120000",
    "test:academy-profiles-base": "vitest run supabase/academy-profiles-base.db.test.ts",
    "test:academy-foundation-integration": "vitest run supabase/academy-foundation-integration.db.test.ts",
    "test:sync-db": "vitest run supabase/academy-cas.db.test.ts --testTimeout 120000",
    "test:academy-cas-postgres": "vitest run supabase/academy-cas.postgres.test.ts",
    "test:study-db": "vitest run supabase/study-engine.db.test.ts --configLoader runner --testTimeout 120000",
    "test:migrations": "vitest run supabase/study-engine-migrations.db.test.ts --configLoader runner --testTimeout 120000"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@tailwindcss/vite": "^4.1.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.22.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
