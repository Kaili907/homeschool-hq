{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuel.academy/schemas/social-studies-lesson-contract-r1-draft.json",
  "title": "Manuel Academy Social Studies Lesson Contract R1 Draft",
  "description": "Advisory curriculum-supply contract for the active Social Studies lesson population. This schema is not a runtime or global release gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "grade",
    "subject",
    "lesson_type",
    "authored_phase",
    "learning_goal",
    "standard_refs",
    "topic_ids",
    "skill_ids",
    "prerequisite_knowledge",
    "background_knowledge",
    "vocabulary",
    "context_framework",
    "reading_burden",
    "source_uses",
    "instructional_blocks",
    "model_analyses",
    "tasks",
    "task_collections",
    "mastery_evidence",
    "remediation_paths",
    "protected_content",
    "tutor_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "social-studies-lesson-standard-r1-draft"
    },
    "lesson_id": {
      "$ref": "#/$defs/id"
    },
    "grade": {
      "enum": [3, 4, 5, 7, 8, 9, 10, 11, 12]
    },
    "subject": {
      "const": "social-studies"
    },
    "lesson_type": {
      "$ref": "#/$defs/lesson_type"
    },
    "authored_phase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "learning_goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "standard_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/standard_ref"
      }
    },
    "topic_ids": {
      "$ref": "#/$defs/id_array"
    },
    "skill_ids": {
      "$ref": "#/$defs/id_array"
    },
    "prerequisite_knowledge": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/prerequisite_knowledge"
      }
    },
    "background_knowledge": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/background_record"
      }
    },
    "vocabulary": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/vocabulary_record"
      }
    },
    "context_framework": {
      "$ref": "#/$defs/context_framework"
    },
    "reading_burden": {
      "$ref": "#/$defs/reading_burden"
    },
    "source_uses": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/source_use"
      }
    },
    "instructional_blocks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/instructional_block"
      }
    },
    "model_analyses": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/model_analysis"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "task_collections": {
      "$ref": "#/$defs/task_collections"
    },
    "mastery_evidence": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/mastery_evidence"
      }
    },
    "remediation_paths": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/remediation_path"
      }
    },
    "protected_content": {
      "$ref": "#/$defs/protected_content"
    },
    "tutor_manifest": {
      "$ref": "#/$defs/tutor_manifest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "instructional_purpose": {
                "const": "DIAGNOSTIC"
              }
            },
            "required": ["instructional_purpose"]
          }
        }
      },
      "then": {
        "properties": {
          "instructional_blocks": {
            "maxItems": 0
          },
          "model_analyses": {
            "maxItems": 0
          },
          "mastery_evidence": {
            "maxItems": 0
          },
          "remediation_paths": {
            "maxItems": 0
          },
          "task_collections": {
            "properties": {
              "diagnostic_task_refs": {
                "minItems": 2
              },
              "guided_task_refs": {
                "maxItems": 0
              },
              "independent_task_refs": {
                "maxItems": 0
              },
              "review_task_refs": {
                "maxItems": 0
              },
              "mastery_task_refs": {
                "maxItems": 0
              },
              "assessment_task_refs": {
                "maxItems": 0
              },
              "project_checkpoint_refs": {
                "maxItems": 0
              },
              "fresh_retry_task_refs": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "instructional_purpose": {
                "const": "BACKGROUND_CONTENT_BUILD"
              }
            },
            "required": ["instructional_purpose"]
          }
        }
      },
      "then": {
        "properties": {
          "background_knowledge": {
            "minItems": 1
          },
          "instructional_blocks": {
            "minItems": 1
          },
          "model_analyses": {
            "minItems": 1
          },
          "mastery_evidence": {
            "minItems": 2
          },
          "remediation_paths": {
            "minItems": 1
          },
          "task_collections": {
            "properties": {
              "guided_task_refs": {
                "minItems": 1
              },
              "independent_task_refs": {
                "minItems": 2
              },
              "mastery_task_refs": {
                "minItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "instructional_purpose": {
                "const": "GUIDED_PRACTICE"
              }
            },
            "required": ["instructional_purpose"]
          }
        }
      },
      "then": {
        "properties": {
          "instructional_blocks": {
            "minItems": 1
          },
          "model_analyses": {
            "minItems": 1
          },
          "mastery_evidence": {
            "minItems": 2
          },
          "remediation_paths": {
            "minItems": 1
          },
          "task_collections": {
            "properties": {
              "guided_task_refs": {
                "minItems": 2
              },
              "independent_task_refs": {
                "minItems": 1
              },
              "mastery_task_refs": {
                "minItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "instructional_purpose": {
                "const": "INDEPENDENT_APPLICATION"
              }
            },
            "required": ["instructional_purpose"]
          }
        }
      },
      "then": {
        "properties": {
          "mastery_evidence": {
            "minItems": 2
          },
          "remediation_paths": {
            "minItems": 1
          },
          "task_collections": {
            "properties": {
              "independent_task_refs": {
                "minItems": 2
              },
              "mastery_task_refs": {
                "minItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "instructional_purpose": {
                "const": "REVIEW"
              }
            },
            "required": ["instructional_purpose"]
          }
        }
      },
      "then": {
        "properties": {
          "instructional_blocks": {
            "minItems": 1
          },
          "mastery_evidence": {
            "minItems": 2
          },
          "remediation_paths": {
            "minItems": 1
          },
          "task_collections": {
            "properties": {
              "review_task_refs": {
                "minItems": 2
              },
              "independent_task_refs": {
                "minItems": 2
              },
              "mastery_task_refs": {
                "minItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "instructional_purpose": {
                "const": "REMEDIATION"
              }
            },
            "required": ["instructional_purpose"]
          }
        }
      },
      "then": {
        "properties": {
          "instructional_blocks": {
            "minItems": 1
          },
          "model_analyses": {
            "minItems": 1
          },
          "mastery_evidence": {
            "minItems": 2
          },
          "remediation_paths": {
            "minItems": 1
          },
          "task_collections": {
            "properties": {
              "guided_task_refs": {
                "minItems": 1
              },
              "fresh_retry_task_refs": {
                "minItems": 1
              },
              "mastery_task_refs": {
                "minItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "instructional_purpose": {
                "const": "MASTERY"
              }
            },
            "required": ["instructional_purpose"]
          }
        }
      },
      "then": {
        "properties": {
          "instructional_blocks": {
            "maxItems": 0
          },
          "model_analyses": {
            "maxItems": 0
          },
          "mastery_evidence": {
            "minItems": 2
          },
          "remediation_paths": {
            "minItems": 1
          },
          "task_collections": {
            "properties": {
              "diagnostic_task_refs": {
                "maxItems": 0
              },
              "guided_task_refs": {
                "maxItems": 0
              },
              "independent_task_refs": {
                "maxItems": 0
              },
              "review_task_refs": {
                "maxItems": 0
              },
              "mastery_task_refs": {
                "minItems": 2
              },
              "assessment_task_refs": {
                "maxItems": 0
              },
              "project_checkpoint_refs": {
                "maxItems": 0
              },
              "fresh_retry_task_refs": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "instructional_purpose": {
                "const": "ASSESSMENT"
              }
            },
            "required": ["instructional_purpose"]
          }
        }
      },
      "then": {
        "properties": {
          "instructional_blocks": {
            "maxItems": 0
          },
          "model_analyses": {
            "maxItems": 0
          },
          "mastery_evidence": {
            "maxItems": 0
          },
          "remediation_paths": {
            "maxItems": 0
          },
          "task_collections": {
            "properties": {
              "diagnostic_task_refs": {
                "maxItems": 0
              },
              "guided_task_refs": {
                "maxItems": 0
              },
              "independent_task_refs": {
                "maxItems": 0
              },
              "review_task_refs": {
                "maxItems": 0
              },
              "mastery_task_refs": {
                "maxItems": 0
              },
              "assessment_task_refs": {
                "minItems": 1
              },
              "project_checkpoint_refs": {
                "maxItems": 0
              },
              "fresh_retry_task_refs": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "instructional_purpose": {
                "const": "PROJECT_INQUIRY"
              }
            },
            "required": ["instructional_purpose"]
          }
        }
      },
      "then": {
        "properties": {
          "instructional_blocks": {
            "minItems": 1
          },
          "model_analyses": {
            "minItems": 1
          },
          "mastery_evidence": {
            "minItems": 1
          },
          "remediation_paths": {
            "minItems": 1
          },
          "task_collections": {
            "properties": {
              "independent_task_refs": {
                "minItems": 1
              },
              "mastery_task_refs": {
                "minItems": 1
              },
              "project_checkpoint_refs": {
                "minItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "disciplinary_modes": {
                "contains": {
                  "const": "GEOGRAPHY_MAP_SKILL"
                }
              }
            },
            "required": ["disciplinary_modes"]
          }
        }
      },
      "then": {
        "properties": {
          "context_framework": {
            "properties": {
              "geography": {
                "properties": {
                  "applicability": {
                    "enum": ["REQUIRED", "HELPFUL"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "disciplinary_modes": {
                "contains": {
                  "const": "HISTORY_CHRONOLOGY"
                }
              }
            },
            "required": ["disciplinary_modes"]
          }
        }
      },
      "then": {
        "properties": {
          "context_framework": {
            "properties": {
              "chronology": {
                "properties": {
                  "applicability": {
                    "enum": ["REQUIRED", "HELPFUL"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "disciplinary_modes": {
                "contains": {
                  "const": "PRIMARY_SOURCE_ANALYSIS"
                }
              }
            },
            "required": ["disciplinary_modes"]
          }
        }
      },
      "then": {
        "properties": {
          "source_uses": {
            "contains": {
              "properties": {
                "relationship_to_inquiry": {
                  "enum": ["PRIMARY", "BOTH_DEPENDS_ON_INQUIRY"]
                }
              },
              "required": ["relationship_to_inquiry"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lesson_type": {
            "properties": {
              "disciplinary_modes": {
                "contains": {
                  "const": "SECONDARY_SOURCE_ANALYSIS"
                }
              }
            },
            "required": ["disciplinary_modes"]
          }
        }
      },
      "then": {
        "properties": {
          "source_uses": {
            "contains": {
              "properties": {
                "relationship_to_inquiry": {
                  "enum": ["SECONDARY", "BOTH_DEPENDS_ON_INQUIRY"]
                }
              },
              "required": ["relationship_to_inquiry"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9:-]*$"
    },
    "id_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "id_array_allow_empty": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "instructional_purpose": {
      "enum": [
        "DIAGNOSTIC",
        "BACKGROUND_CONTENT_BUILD",
        "GUIDED_PRACTICE",
        "INDEPENDENT_APPLICATION",
        "REVIEW",
        "REMEDIATION",
        "MASTERY",
        "ASSESSMENT",
        "PROJECT_INQUIRY"
      ]
    },
    "disciplinary_mode": {
      "enum": [
        "GEOGRAPHY_MAP_SKILL",
        "HISTORY_CHRONOLOGY",
        "CIVICS_GOVERNMENT",
        "ECONOMICS",
        "PRIMARY_SOURCE_ANALYSIS",
        "SECONDARY_SOURCE_ANALYSIS",
        "COMPARE_PERSPECTIVE",
        "CLAIM_EVIDENCE_REASONING",
        "QUANTITATIVE_DATA_ANALYSIS",
        "RESEARCH_SOURCE_CRITICISM",
        "DELIBERATION_CIVIC_ACTION"
      ]
    },
    "lesson_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructional_purpose",
        "disciplinary_modes",
        "secondary_purposes"
      ],
      "properties": {
        "instructional_purpose": {
          "$ref": "#/$defs/instructional_purpose"
        },
        "disciplinary_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/disciplinary_mode"
          }
        },
        "secondary_purposes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/instructional_purpose"
          }
        }
      }
    },
    "standard_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework_ref", "mapping_status"],
      "properties": {
        "framework_ref": {
          "$ref": "#/$defs/id"
        },
        "standard_id": {
          "$ref": "#/$defs/id"
        },
        "legacy_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "mapping_status": {
          "enum": ["canonical", "unverified", "human-review"]
        }
      },
      "anyOf": [
        {
          "required": ["standard_id"]
        },
        {
          "required": ["legacy_label"]
        }
      ]
    },
    "prerequisite_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_id", "learner_need", "source_refs"],
      "properties": {
        "knowledge_id": {
          "$ref": "#/$defs/id"
        },
        "learner_need": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "source_refs": {
          "$ref": "#/$defs/id_array_allow_empty"
        }
      }
    },
    "background_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background_id",
        "delivery",
        "learner_explanation",
        "why_needed",
        "source_refs"
      ],
      "properties": {
        "background_id": {
          "$ref": "#/$defs/id"
        },
        "delivery": {
          "enum": [
            "TEACH_BEFORE_TASK",
            "RETRIEVE_BEFORE_TASK",
            "REFERENCE_DURING_TASK",
            "WITHHOLD_UNTIL_AFTER_EVIDENCE"
          ]
        },
        "learner_explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "why_needed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "source_refs": {
          "$ref": "#/$defs/id_array_allow_empty"
        }
      }
    },
    "vocabulary_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocabulary_id",
        "term",
        "learner_definition",
        "first_use_ref"
      ],
      "properties": {
        "vocabulary_id": {
          "$ref": "#/$defs/id"
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "learner_definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "first_use_ref": {
          "$ref": "#/$defs/id"
        },
        "example": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "non_example": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "pronunciation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "context_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "learner_explanation", "resource_refs", "review_rationale"],
      "properties": {
        "applicability": {
          "enum": ["REQUIRED", "HELPFUL", "NOT_APPLICABLE"]
        },
        "learner_explanation": {
          "type": "string",
          "maxLength": 4000
        },
        "resource_refs": {
          "$ref": "#/$defs/id_array_allow_empty"
        },
        "review_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "context_framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "people_and_groups",
        "place",
        "time",
        "conditions",
        "why_it_matters",
        "chronology",
        "geography"
      ],
      "properties": {
        "people_and_groups": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "place": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "conditions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "chronology": {
          "$ref": "#/$defs/context_dimension"
        },
        "geography": {
          "$ref": "#/$defs/context_dimension"
        }
      }
    },
    "reading_burden": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_text_load",
        "academy_explanation_load",
        "response_load",
        "chunking_plan",
        "supports",
        "target_alignment_rationale"
      ],
      "properties": {
        "source_text_load": {
          "enum": ["NONE", "LIGHT", "MODERATE", "SUSTAINED", "AUTHENTIC_COMPLEX"]
        },
        "academy_explanation_load": {
          "enum": ["LIGHT", "MODERATE", "SUSTAINED"]
        },
        "response_load": {
          "enum": ["BRIEF", "MULTI_PART", "SUSTAINED", "PROJECT"]
        },
        "chunking_plan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "supports": {
          "$ref": "#/$defs/support_array"
        },
        "target_alignment_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "source_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "instructional_roles",
        "relationship_to_inquiry",
        "classification_rationale",
        "label_visibility",
        "context_before_analysis",
        "excerpt_treatment",
        "original_or_repost",
        "evidence_locator",
        "rights_access_ref"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/id"
        },
        "instructional_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
