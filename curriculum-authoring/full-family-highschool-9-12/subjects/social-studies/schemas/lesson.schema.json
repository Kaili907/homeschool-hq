{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuel.academy/schemas/curriculum-lesson-hs-v1.json",
  "title": "Manuel Academy High School Curriculum Lesson v1",
  "description": "High school 9-12 variant of the Manuel Academy curriculum lesson schema. Field shapes match curriculum-content/manuel-academy/1.0.0/schemas/lesson.schema.json; the grade enum and lesson_id pattern are extended to grades 9-12, and source-integrity and tutor-boundary fields are required.",
  "type": "object",
  "required": [
    "schema_version",
    "lesson_id",
    "course_id",
    "grade",
    "subject",
    "course_day",
    "unit_number",
    "title",
    "phase",
    "focus",
    "standards",
    "learning_objectives",
    "lesson_flow",
    "formative_check",
    "mastery_rule",
    "accessibility_and_accommodations",
    "safety_and_privacy",
    "source_use",
    "citation_requirement",
    "tutor_boundary",
    "static_path_available"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^ma-g(9|10|11|12)-[a-z-]+-u[0-9]{2}-l[0-9]{2}$"
    },
    "course_id": {
      "type": "string"
    },
    "grade": {
      "enum": [
        9,
        10,
        11,
        12
      ]
    },
    "subject": {
      "enum": [
        "social-studies"
      ]
    },
    "course_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "unit_number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "phase": {
      "type": "string"
    },
    "focus": {
      "type": "string"
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "lesson_flow": {
      "type": "array",
      "minItems": 5
    },
    "formative_check": {
      "type": "string"
    },
    "mastery_rule": {
      "type": "string"
    },
    "accessibility_and_accommodations": {
      "type": "array",
      "minItems": 5
    },
    "safety_and_privacy": {
      "type": "array",
      "minItems": 2
    },
    "source_use": {
      "type": "object",
      "required": [
        "primary_secondary",
        "unit_source_focus",
        "anchor_sources",
        "retrieval_note"
      ]
    },
    "citation_requirement": {
      "type": "string"
    },
    "tutor_boundary": {
      "type": "string"
    },
    "static_path_available": {
      "const": true
    }
  },
  "additionalProperties": true
}
