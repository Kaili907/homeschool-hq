 {
  "schema_set_version": "2.0.0",
  "course_id": "ma-hs12-earth-space-environmental",
  "grade": 12,
  "subject": "science",
  "title": "Earth, Space, and Environmental Systems",
  "description": "An integrated synthesis course covering the full HS-ESS1, HS-ESS2, and HS-ESS3 bands - the 19 performance expectations most often left uncovered by a three-year disciplinary sequence. Placed last because it genuinely depends on the other three: stellar nucleosynthesis needs Chemistry's atomic model, the carbon cycle needs Biology's photosynthesis and respiration, and climate modelling needs all three plus quantitative reasoning. The course is data-intensive and low-hazard; most investigations use published datasets the family retrieves, and the sun is never observed directly by any means.",
  "capstone": "The Grade 12 capstone: analyse a global challenge, build a computational simulation of coupled Earth and human systems, evaluate competing solutions on prioritised criteria and trade-offs, refine, and defend with stated limitations.",
  "days": 108,
  "order": 4,
  "unit_refs": [
   "ma-hs12-earth-space-environmental-u01",
