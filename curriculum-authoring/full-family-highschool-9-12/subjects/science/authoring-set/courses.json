[
 {
  "schema_set_version": "2.0.0",
  "course_id": "ma-hs9-biology",
  "grade": 9,
  "subject": "science",
  "title": "Biology",
  "description": "A first high school laboratory science building directly on the Grade 8 middle-school band. The course develops molecular and cellular biology from foundations, then raises the Grade 8 heredity, natural selection, and ecosystem strands to the high school performance-expectation band. Biology is the credit Michigan names explicitly in MCL 380.1278b(1)(b), so it is placed in Grade 9 and banked first. Every investigation is household-safe, every investigation has a no-special-equipment alternative, and no activity anywhere in the course measures the learner's own body or health.",
  "capstone": "A biodiversity engineering defense: define criteria and constraints for a real conservation problem, model and simulate a solution, evaluate trade-offs, and defend the revision history with stated limitations.",
  "days": 108,
  "order": 1,
