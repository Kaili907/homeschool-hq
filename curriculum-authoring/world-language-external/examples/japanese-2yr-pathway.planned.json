{
  "schema_version": "manuel-academy-world-language-external-pathway-1.0",
  "pathway_id": "wl-ext-path-japanese-2yr",
  "language": {
    "name": "Japanese",
    "iso_639_1": "ja",
    "iso_639_3": "jpn"
  },
  "intent": "Two years of the same language, sourced externally, for a college-ready transcript. Japanese is the intended language because it is already the house language; the contract is language-agnostic and this pathway can be re-keyed to another language without schema change.",
  "target": {
    "credits": 2,
    "semesters": 4,
    "proficiency_target": "ACTFL Novice High",
    "proficiency_target_basis": "Michigan states its world-language requirement as two credits 'based on students meeting a Novice High proficiency level'. Recorded as the design target for a Manuel Academy pathway, NOT as a requirement binding this homeschool. Claimable only on an external artifact, and only on a pathway that delivered two credits — see validator rules R5, R12 and P4. The ~360-hour figure often quoted alongside it is extrapolated and is not an MDE number."
  },
  "provider_selection": {
    "status": "unselected",
    "endorsed_provider": null,
    "criteria": [
      "Issues a transcript or report card in the provider’s own name, naming the course and the term.",
      "Publishes a syllabus obtainable BEFORE enrolment, so evidence.syllabus can be filled at status=enrolled.",
      "Grades on a stated scale, with the scale itself documented.",
      "Provides an instructor who gives feedback on produced Japanese — the elementary plan explicitly assumed an instructor who does not speak the language, and that is the capacity gap being purchased.",
      "States its accreditation status plainly, including stating that it has none.",
      "For dual enrolment: confirms the course carries transferable college credit and appears on a college transcript.",
      "Does not require Manuel Academy to represent the provider’s coursework as its own.",
      "Has a stated path to, or compatibility with, an external proficiency artifact."
    ],
    "candidates_considered": []
  },
