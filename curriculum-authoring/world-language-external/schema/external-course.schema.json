{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manuel-academy-world-language-external-course-1.0",
  "title": "Manuel Academy — external World Language course record",
  "description": "One term of a world-language course TAUGHT AND ASSESSED BY AN EXTERNAL PROVIDER. Manuel Academy records and verifies it; Manuel Academy did not author it. Structural shape only — the honesty rules that cannot be expressed in JSON Schema live in validate-external-course.mjs and external-course-contract.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "subject_family",
    "authorship",
    "status",
    "language",
    "provider",
    "course",
    "term",
    "placement",
    "credit",
    "evidence",
    "tracking",
    "final_grade",
    "proficiency",
    "parent_verification",
    "mmc_claim",
    "graduation_claim"
  ],
  "properties": {
    "schema_version": { "const": "manuel-academy-world-language-external-course-1.0" },
    "record_id": {
      "type": "string",
      "pattern": "^wl-ext-[a-z]{2,3}-s[0-9]{2}$",
      "description": "wl-ext-<iso_639_3 or 639_1>-s<NN>. Deliberately NOT the ma-g<grade>-<subject> grammar: these identifiers must never be mistaken for authored Manuel Academy courses."
    },
    "subject_family": { "const": "world-language" },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authored_by", "manuel_academy_role", "statement"],
      "properties": {
        "authored_by": { "const": "external-provider" },
        "manuel_academy_role": { "const": "records-and-verifies-only" },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "Plain-language attribution carried onto every derived surface."
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["template", "planned", "enrolled", "in-progress", "completed", "withdrawn", "not-completed"]
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "iso_639_1", "iso_639_3", "notes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "iso_639_1": { "type": ["string", "null"], "pattern": "^[a-z]{2}$" },
        "iso_639_3": { "type": "string", "pattern": "^[a-z]{3}$" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_status", "legal_name", "kind", "accreditation", "reference"],
      "properties": {
        "selection_status": { "type": "string", "enum": ["unselected", "selected", "verified"] },
        "legal_name": { "type": ["string", "null"] },
        "kind": {
          "type": "string",
          "enum": ["unselected", "online-provider", "dual-enrollment", "co-op", "private-instructor", "other"]
        },
        "accreditation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claimed", "verified_by_parent", "verified_on"],
          "properties": {
            "claimed": { "type": ["string", "null"] },
            "verified_by_parent": { "type": "boolean" },
            "verified_on": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "catalog_id", "retrieved_on", "contact"],
          "properties": {
            "url": { "type": ["string", "null"] },
            "catalog_id": { "type": ["string", "null"] },
            "retrieved_on": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "contact": { "type": ["string", "null"] }
          }
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "provider_course_code", "level_label", "delivery", "claimed_contact_hours"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "provider_course_code": { "type": ["string", "null"] },
        "level_label": { "type": ["string", "null"] },
        "delivery": {
          "type": "string",
          "enum": ["unknown", "synchronous-online", "asynchronous-online", "hybrid", "in-person"]
        },
        "claimed_contact_hours": { "type": ["number", "null"], "minimum": 0, "maximum": 400 }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence_position", "semester_label", "school_year", "term", "start_date", "end_date"],
      "properties": {
        "sequence_position": { "type": "integer", "minimum": 1, "maximum": 8 },
        "semester_label": { "type": "string", "pattern": "^S[0-9]$" },
        "school_year": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{4}$" },
        "term": { "type": "string", "enum": ["fall", "spring", "summer", "full-year", "unscheduled"] },
        "start_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "counts_toward"],
      "properties": {
        "grade": { "type": "string", "enum": ["9", "10", "11", "12"] },
        "counts_toward": { "const": "world-language" }
      }
    },
    "credit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "awarded", "basis", "provider_credit_value"],
      "properties": {
        "requested": { "type": "number", "minimum": 0, "maximum": 2 },
        "awarded": { "type": ["number", "null"], "minimum": 0, "maximum": 2 },
        "basis": {
          "type": "string",
          "enum": ["provider-awarded", "dual-enrollment-semester-hours", "parent-awarded-on-provider-evidence"]
        },
        "provider_credit_value": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syllabus", "transcript", "assignments", "proficiency_artifact", "other"],
      "properties": {
        "syllabus": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
        "transcript": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
        "assignments": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
        "proficiency_artifact": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
        "other": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } }
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignments_reported", "assignments_completed", "completion_source", "last_updated"],
      "properties": {
        "assignments_reported": { "type": ["integer", "null"], "minimum": 0 },
        "assignments_completed": { "type": ["integer", "null"], "minimum": 0 },
        "completion_source": {
          "type": "string",
          "enum": ["none", "provider-portal", "provider-report", "instructor-report"]
        },
        "last_updated": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "final_grade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reported", "scale", "source"],
      "properties": {
        "reported": { "type": ["string", "null"] },
        "scale": {
          "type": ["string", "null"],
          "enum": [null, "A-F", "percent", "pass-fail", "college-letter", "narrative"]
        },
        "source": {
          "type": "string",
          "enum": ["none", "provider-transcript", "provider-report-card", "instructor-letter"]
        }
      }
    },
    "proficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimed_level", "framework", "artifact_ref", "assessed_on"],
      "properties": {
        "claimed_level": { "type": ["string", "null"] },
        "framework": { "type": ["string", "null"], "enum": [null, "ACTFL", "CEFR", "JLPT", "other"] },
        "artifact_ref": { "type": ["string", "null"] },
        "assessed_on": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "parent_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_by", "verified_on", "method", "statement"],
      "properties": {
        "verified_by": { "type": ["string", "null"] },
        "verified_on": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "method": {
          "type": "string",
          "enum": ["none", "primary-document", "copy-of-document", "verbal-report"]
        },
        "statement": { "type": ["string", "null"] }
      }
    },
    "mmc_claim": {
      "type": "string",
      "enum": ["none", "recorded-not-claimed"],
      "description": "This contract never asserts that a state requirement is satisfied. mac/world-language-decision-r1 found the MMC binds school boards, not this family."
    },
    "graduation_claim": { "const": "none" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "location", "obtained_on", "verified_by_parent"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "syllabus",
            "course-catalog-entry",
            "enrollment-confirmation",
            "provider-transcript",
            "report-card",
            "assignment-log",
            "sample-work",
            "proficiency-score-report",
            "instructor-letter",
            "receipt",
            "other"
          ]
        },
        "description": { "type": "string", "minLength": 1 },
        "location": {
          "type": "string",
          "minLength": 1,
          "description": "Where the document physically or digitally lives. Never a path into Manuel Academy's own authored curriculum — see rule R6."
        },
        "obtained_on": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "verified_by_parent": { "type": "boolean" }
      }
    }
  }
}
