{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manuel-academy-world-language-external-pathway-1.0",
  "title": "Manuel Academy — external World Language pathway",
  "description": "An ordered sequence of external course records in ONE language. The unit that matters to a college transcript is the pathway, not the semester: U-M (LSA) and MSU both express their expectation as two years of the SAME language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pathway_id",
    "language",
    "intent",
    "target",
    "provider_selection",
    "records",
    "transcript",
    "graduation_completeness",
    "mmc_note",
    "integration"
  ],
  "properties": {
    "schema_version": { "const": "manuel-academy-world-language-external-pathway-1.0" },
    "pathway_id": { "type": "string", "pattern": "^wl-ext-path-[a-z0-9-]+$" },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "iso_639_1", "iso_639_3"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "iso_639_1": { "type": ["string", "null"], "pattern": "^[a-z]{2}$" },
        "iso_639_3": { "type": "string", "pattern": "^[a-z]{3}$" }
      }
    },
    "intent": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credits", "semesters", "proficiency_target", "proficiency_target_basis"],
      "properties": {
        "credits": { "type": "number", "minimum": 0, "maximum": 8 },
        "semesters": { "type": "integer", "minimum": 1, "maximum": 8 },
        "proficiency_target": { "type": ["string", "null"] },
        "proficiency_target_basis": { "type": ["string", "null"] }
      }
    },
    "provider_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "endorsed_provider", "criteria", "candidates_considered"],
      "properties": {
        "status": { "type": "string", "enum": ["unselected", "selected"] },
        "endorsed_provider": {
          "const": null,
          "description": "Structurally null. No lane may endorse a paid provider in code; provider choice is the Director's, made against `criteria`."
        },
        "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "candidates_considered": { "type": "array", "items": { "type": "string" } }
      }
    },
    "records": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollup_label", "source_attribution", "proficiency_claim", "gpa_treatment"],
      "properties": {
        "rollup_label": { "type": "string", "minLength": 1 },
        "source_attribution": { "type": "string", "minLength": 1 },
        "proficiency_claim": { "type": ["string", "null"] },
        "gpa_treatment": {
          "type": "string",
          "enum": ["excluded", "included-on-provider-grade", "undecided"]
        }
      }
    },
    "graduation_completeness": { "const": "NOT_GRADUATION_COMPLETE_UNCHANGED" },
    "mmc_note": { "type": "string", "minLength": 1 },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_eleventh_subject", "performed_in_this_lane", "see"],
      "properties": {
        "requires_eleventh_subject": { "type": "boolean" },
        "performed_in_this_lane": { "const": false },
        "see": { "type": "string", "minLength": 1 }
      }
    }
  }
}
