{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manuel.academy/schemas/curriculum-lesson-v1.json",
  "title": "Manuel Academy Curriculum Lesson v1",
  "type": "object",
  "required": [
    "schema_version",
    "lesson_id",
    "course_id",
    "grade",
    "subject",
    "course_day",
    "unit_number",
    "title",
    "phase",
    "focus",
    "standards",
    "learning_objectives",
    "lesson_flow",
    "formative_check",
    "mastery_rule",
    "accessibility_and_accommodations",
    "safety_and_privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^ma-g(5|7|8)-[a-z-]+-u[0-9]{2}-l[0-9]{2}$"
    },
    "course_id": {
      "type": "string"
    },
    "grade": {
      "enum": [
        5,
        7,
        8
      ]
    },
    "subject": {
      "enum": [
        "mathematics",
        "english-language-arts",
        "science",
        "social-studies",
        "health",
        "physical-education",
        "ready-for-life",
        "technology",
        "arts-and-music",
        "financial-literacy"
      ]
    },
    "course_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "unit_number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "phase": {
      "type": "string"
    },
    "focus": {
      "type": "string"
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "lesson_flow": {
      "type": "array",
      "minItems": 5
    },
    "formative_check": {
      "type": "string"
    },
    "mastery_rule": {
      "type": "string"
    },
    "accessibility_and_accommodations": {
      "type": "array",
      "minItems": 5
    },
    "safety_and_privacy": {
      "type": "array",
      "minItems": 2
    }
  },
  "additionalProperties": true
}
